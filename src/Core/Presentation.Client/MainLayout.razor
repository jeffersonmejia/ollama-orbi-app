@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="m3-app-layout" id="m3-app-layout">
    <nav class="m3-nav-rail" aria-label="Navegación principal">
        <div class="m3-nav-rail-header">
            <LegacyNavigationLink Href="/" Class="m3-nav-brand" Title="Orbi">
                <span class="m3-nav-brand-mark material-symbols-outlined" aria-hidden="true">shopping_bag</span>
                <span class="m3-nav-brand-label">Orbi</span>
            </LegacyNavigationLink>
        </div>

        <ul class="m3-nav-items">
            <li>
                <NavLink class="m3-nav-item" href="/app/asistente" Match="NavLinkMatch.All">
                    <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                    <span>Asistente</span>
                </NavLink>
            </li>
            <li>
                <LegacyNavigationLink Href="/Delivery/Index" Class="m3-nav-item">
                    <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
                    <span>Tiendas</span>
                </LegacyNavigationLink>
            </li>
            @if (_user.IsInRole("Usuario"))
            {
                <li><LegacyNavigationLink Href="/Delivery/MyOrders" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">receipt_long</span><span>Pedidos</span></LegacyNavigationLink></li>
                <li><LegacyNavigationLink Href="/Delivery/MyPayments" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">payments</span><span>Pagos</span></LegacyNavigationLink></li>
                <li><LegacyNavigationLink Href="/Delivery/Cart" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span><span>Carrito</span></LegacyNavigationLink></li>
            }
            @if (_user.IsInRole("Repartidor"))
            {
                <li><LegacyNavigationLink Href="/Delivery/Deliveries" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">delivery_dining</span><span>Entregas</span></LegacyNavigationLink></li>
            }
            @if (_user.IsInRole("Administrador"))
            {
                <li><LegacyNavigationLink Href="/Delivery/Admin" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span><span>Admin</span></LegacyNavigationLink></li>
            }
        </ul>

        @if (_user.Identity?.IsAuthenticated == true)
        {
            <div class="m3-nav-rail-footer">
                <LegacyNavigationLink Href="/Identity/Account/Manage/Index" Class="m3-nav-item orbi-profile-nav-item" Title="@_user.Identity.Name">
                    <span class="material-symbols-outlined" aria-hidden="true">person</span>
                    <span class="orbi-profile-label"><span>Perfil</span><small>@_primaryRole</small></span>
                </LegacyNavigationLink>
            </div>
        }
        else
        {
            <div class="m3-nav-rail-footer">
                <LegacyNavigationLink Href="/Identity/Account/Login" Class="m3-nav-item"><span class="material-symbols-outlined" aria-hidden="true">login</span><span>Iniciar sesión</span></LegacyNavigationLink>
                <NavLink href="/registro" class="m3-nav-item" Match="NavLinkMatch.All"><span class="material-symbols-outlined" aria-hidden="true">person_add</span><span>Registro</span></NavLink>
            </div>
        }
    </nav>

    <div class="m3-content-area orbi-assistant-content-area">
        <main class="m3-main orbi-assistant-main">
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <section class="orbi-route-error" role="alert">
                        <span class="material-symbols-outlined" aria-hidden="true">error</span>
                        <h1>No se pudo cargar esta sección</h1>
                        <p>Ocurrió un error inesperado. Intenta de nuevo o vuelve al inicio.</p>
                        <button class="m3-filled-button" @onclick="ReloadPage">Volver a intentar</button>
                    </section>
                </ErrorContent>
            </ErrorBoundary>
        </main>
        <footer class="m3-footer orbi-assistant-footer">&copy; 2026 Orbi. Todos los derechos reservados.</footer>
    </div>
</div>

@code {
    private System.Security.Claims.ClaimsPrincipal _user = new(new System.Security.Claims.ClaimsIdentity());
    private string _primaryRole = "Sin rol";

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _primaryRole = new[] { "Administrador", "Vendedor", "Repartidor", "Usuario" }
            .FirstOrDefault(_user.IsInRole) ?? "Sin rol";
    }

    private void ReloadPage() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
