@using System.Net.Http.Json
@using System.Text.Json
@using OrbiApp.Presentation.Client.Networking
@inject HttpClient Api
@inject NavigationManager Navigation

<nav class="orbi-account-navigation" aria-label="Secciones de la cuenta">
    <div class="orbi-account-nav">
        <NavLink href="/Identity/Account/Manage" Match="NavLinkMatch.All"><span class="material-symbols-outlined" aria-hidden="true">person</span><span>Perfil</span></NavLink>
        <NavLink href="/Identity/Account/Manage/Addresses"><span class="material-symbols-outlined" aria-hidden="true">location_on</span><span>Direcciones</span></NavLink>
        <NavLink href="/Identity/Account/Manage/PaymentMethods"><span class="material-symbols-outlined" aria-hidden="true">payment</span><span>Pagos</span></NavLink>
        <LegacyNavigationLink Href="/Identity/Account/Manage/Security" Class="orbi-account-nav-legacy"><span class="material-symbols-outlined" aria-hidden="true">security</span><span>Seguridad</span></LegacyNavigationLink>
        <button type="button" class="orbi-account-logout" disabled="@_busy" @onclick="LogoutAsync"><span class="material-symbols-outlined" aria-hidden="true">logout</span><span>@(_busy ? "Saliendo…" : "Salir")</span></button>
    </div>
</nav>
@if (_error is not null) { <p class="m3-validation-error" role="alert">@_error</p> }

@code {
    private string? _requestToken;
    private string? _error;
    private bool _busy;

    private async Task LogoutAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            _requestToken ??= (await Api.GetFromJsonAsync<AntiforgeryResponse>("/api/security/antiforgery"))?.RequestToken;
            if (string.IsNullOrWhiteSpace(_requestToken)) throw new InvalidOperationException();
            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/identity/account/logout");
            request.Headers.Add("RequestVerificationToken", _requestToken);
            using var response = await Api.SendAsync(request);
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException();
            try { await JS.InvokeVoidAsync("orbiSessionCache.clear"); } catch (JSException) { }
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException or TaskCanceledException)
        { _error = "No se pudo cerrar la sesión. Inténtalo de nuevo."; _busy = false; }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    private sealed record AntiforgeryResponse(string RequestToken);
}
