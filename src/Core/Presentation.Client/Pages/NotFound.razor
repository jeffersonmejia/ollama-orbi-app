@page "/not-found"
<PageTitle>Página no encontrada - Orbi</PageTitle>
<section class="orbi-route-error" role="status">
    <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
    <p class="orbi-error-code">404</p>
    <h1>No encontramos esta página</h1>
    <p>La dirección puede haber cambiado o ya no estar disponible.</p>
    <LegacyNavigationLink Href="/" Class="m3-filled-button">Volver al inicio</LegacyNavigationLink>
</section>
