@page "/Delivery/Deliveries"
@attribute [Authorize(Roles = "Repartidor")]

<PageTitle>Mis entregas - Dash</PageTitle>

<OrdersList IsDeliveryPerson="true" SearchTerm="SearchTerm" Page="Page" />

@code {
    [SupplyParameterFromQuery(Name = "buscar")]
    public string? SearchTerm { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;
}
