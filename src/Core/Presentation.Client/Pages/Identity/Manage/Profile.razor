@page "/Identity/Account/Manage"
@page "/Identity/Account/Manage/Index"
@attribute [Authorize]
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using OrbiApp.Presentation.Client.Networking
@inject HttpClient Api

<PageTitle>Perfil - Dash</PageTitle>

<div class="orbi-account-shell">
    <AccountManageNavigation />
    <div class="orbi-account-page">
        @if (_isLoading)
        {
            <p class="m3-loading-message" role="status">Cargando perfil…</p>
        }
        else if (_profile is not null)
        {
            <header class="orbi-account-identity">
                <div class="orbi-account-avatar">@(_profile.Username.Length > 0 ? _profile.Username[..1].ToUpperInvariant() : "U")</div>
                <h1>@_profile.Username</h1><span>@_profile.RoleSummary</span>
            </header>
            <section class="orbi-google-card">
                <div class="orbi-google-card-heading"><div><h2>Perfil y correo</h2><p>Administra tus datos básicos y el correo de tu cuenta.</p></div><span class="material-symbols-outlined" aria-hidden="true">person</span></div>
                @if (_message is not null) { <p class="m3-success-message" role="status">@_message</p> }
                @if (_error is not null) { <p class="m3-validation-error" role="alert">@_error</p> }
                <EditForm Model="_phone" OnValidSubmit="SavePhoneAsync" class="orbi-account-rows">
                    <DataAnnotationsValidator />
                    <div class="orbi-account-row"><label>Nombre de usuario</label><span>@_profile.Username</span></div>
                    <div class="orbi-account-row"><label>Rol</label><span>@_profile.RoleSummary</span></div>
                    <div class="m3-text-field"><label class="m3-text-field-label" for="profile-phone">Teléfono</label><InputText id="profile-phone" @bind-Value="_phone.PhoneNumber" class="m3-text-field-input" autocomplete="tel" /><ValidationMessage For="() => _phone.PhoneNumber" /></div>
                    <button type="submit" class="m3-filled-button" disabled="@_busy">@(_busy ? "Guardando…" : "Guardar perfil")</button>
                </EditForm>
                <div class="orbi-account-rows">
                    <div class="orbi-account-row"><span><strong>Correo</strong><br />@_profile.Email</span><span class="material-symbols-outlined" aria-label="@(_profile.IsEmailConfirmed ? "Correo verificado" : "Correo sin verificar")">@(_profile.IsEmailConfirmed ? "verified" : "mark_email_unread")</span></div>
                    @if (!_profile.IsEmailConfirmed)
                    {
                        <button type="button" class="m3-text-button" disabled="@_busy" @onclick="SendVerificationAsync">Enviar correo de verificación</button>
                    }
                    <EditForm Model="_email" OnValidSubmit="ChangeEmailAsync" class="orbi-account-rows">
                        <DataAnnotationsValidator />
                        <div class="m3-text-field"><label class="m3-text-field-label" for="profile-new-email">Nuevo correo</label><InputText id="profile-new-email" @bind-Value="_email.NewEmail" class="m3-text-field-input" autocomplete="email" /><ValidationMessage For="() => _email.NewEmail" /></div>
                        <button type="submit" class="m3-filled-button" disabled="@_busy">@(_busy ? "Enviando…" : "Cambiar correo")</button>
                    </EditForm>
                </div>
            </section>
        }
        else if (_error is not null)
        {
            <section class="orbi-route-error" role="alert"><p>@_error</p><button type="button" class="m3-text-button" @onclick="LoadProfileAsync">Reintentar</button></section>
        }
    </div>
</div>

@code {
    private IdentityProfileResponse? _profile;
    private UpdateIdentityPhoneRequest _phone = new();
    private ChangeIdentityEmailRequest _email = new();
    private bool _isLoading = true, _busy;
    private string? _error, _message, _requestToken;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true; _error = null;
        try
        {
            _profile = await Api.GetFromJsonAsync<IdentityProfileResponse>("/api/identity/account/profile") ?? throw new JsonException();
            _phone = new UpdateIdentityPhoneRequest { PhoneNumber = _profile.PhoneNumber };
            _email = new ChangeIdentityEmailRequest { NewEmail = _profile.Email };
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        { _error = "No se pudo cargar tu perfil. Inténtalo de nuevo."; _profile = null; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task SavePhoneAsync()
    {
        await SendActionAsync(HttpMethod.Put, "/api/identity/account/profile/phone", _phone);
        if (_profile is not null && _error is null) _profile = _profile with { PhoneNumber = _phone.PhoneNumber };
    }

    private Task ChangeEmailAsync() => SendActionAsync(HttpMethod.Post, "/api/identity/account/profile/email-change", _email);
    private Task SendVerificationAsync() => SendActionAsync(HttpMethod.Post, "/api/identity/account/profile/verification-email", null);

    private async Task SendActionAsync(HttpMethod method, string path, object? payload)
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try
        {
            await EnsureRequestTokenAsync();
            using var request = new HttpRequestMessage(method, path);
            request.Headers.Add("RequestVerificationToken", _requestToken);
            if (payload is not null) request.Content = JsonContent.Create(payload);
            using var response = await Api.SendAsync(request);
            if (!response.IsSuccessStatusCode) { _error = await ReadErrorAsync(response); return; }
            _message = (await response.Content.ReadFromJsonAsync<IdentityAccountActionResponse>())?.Message ?? "Cambios guardados.";
            if (path.EndsWith("email-change", StringComparison.Ordinal)) _email.NewEmail = string.Empty;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException or TaskCanceledException)
        { _error = "No se pudo completar la solicitud. Inténtalo de nuevo."; }
        finally { _busy = false; }
    }

    private async Task EnsureRequestTokenAsync()
    {
        _requestToken ??= (await Api.GetFromJsonAsync<AntiforgeryResponse>("/api/security/antiforgery"))?.RequestToken;
        if (string.IsNullOrWhiteSpace(_requestToken)) throw new InvalidOperationException();
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized) return "Tu sesión ya no está activa. Inicia sesión nuevamente.";
        try
        {
            using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (json.RootElement.TryGetProperty("message", out var message) && !string.IsNullOrWhiteSpace(message.GetString())) return message.GetString()!;
        }
        catch (JsonException) { }
        return "No se pudo actualizar la información.";
    }

    private sealed record AntiforgeryResponse(string RequestToken);
}
