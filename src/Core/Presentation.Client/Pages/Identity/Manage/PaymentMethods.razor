@page "/Identity/Account/Manage/PaymentMethods"
@attribute [Authorize]

<PageTitle>Pagos - Dash</PageTitle>

<div class="orbi-account-shell">
    <AccountManageNavigation />
    <div class="orbi-account-page orbi-payment-page">
        <header class="orbi-account-page-title orbi-payment-page-title">
            <h1>Pagos</h1>
            <p>Consulta el proveedor habilitado para pagar tus pedidos.</p>
        </header>

        <section class="orbi-google-card orbi-payment-card" aria-labelledby="payment-provider-title">
            <header class="orbi-payment-card-heading">
                <div>
                    <span class="orbi-payment-eyebrow">Método de pago</span>
                    <h2 id="payment-provider-title">Proveedor para tus compras</h2>
                    <p>Elige el proveedor que se usará al completar un pedido.</p>
                </div>
                <span class="material-symbols-outlined orbi-payment-heading-icon" aria-hidden="true">payments</span>
            </header>
            <div class="orbi-payment-provider" aria-current="true">
                <span class="orbi-payment-provider-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">account_balance_wallet</span>
                </span>
                <div class="orbi-payment-provider-copy">
                    <h3>PayPal</h3>
                    <p>Pago rápido y seguro para tus pedidos.</p>
                </div>
                <span class="orbi-payment-provider-status">
                    <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                    Configurado
                </span>
            </div>
            <div class="orbi-payment-note">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>El pago se realiza mediante PayPal al finalizar tu compra.</p>
            </div>
        </section>
    </div>
</div>
