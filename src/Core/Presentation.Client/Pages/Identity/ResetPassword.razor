@page "/Identity/Account/ResetPassword"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Api
@inject NavigationManager Navigation

<PageTitle>Restablecer contraseña - Dash</PageTitle>

<div class="orbi-login-page">
    <section class="m3-card orbi-login-card" aria-labelledby="reset-password-title">
        <h1 id="reset-password-title">Restablecer contraseña</h1>
        @if (!_hasCode)
        {
            <p class="orbi-auth-message error" role="alert">El enlace de restablecimiento no es válido o venció.</p>
            <div class="orbi-login-links"><NavLink href="/Identity/Account/ForgotPassword">Solicitar otro enlace</NavLink></div>
        }
        else
        {
            @if (_message is not null)
            {
                <p class="orbi-auth-message @(_isError ? "error" : string.Empty)" role="@(_isError ? "alert" : "status")">@_message</p>
            }
            <EditForm Model="_input" OnValidSubmit="SubmitAsync" class="orbi-login-form">
                <DataAnnotationsValidator />
                <div class="m3-text-field">
                    <InputText id="reset-email" @bind-Value="_input.Email" class="m3-text-field-input" autocomplete="username" placeholder="correo@ejemplo.com" />
                    <label class="m3-text-field-label" for="reset-email">Correo electrónico</label>
                    <ValidationMessage For="() => _input.Email" class="m3-validation-error" />
                </div>
                <div class="m3-text-field">
                    <InputText id="reset-password" @bind-Value="_input.Password" type="password" class="m3-text-field-input" autocomplete="new-password" placeholder=" " />
                    <label class="m3-text-field-label" for="reset-password">Nueva contraseña</label>
                    <ValidationMessage For="() => _input.Password" class="m3-validation-error" />
                </div>
                <div class="m3-text-field">
                    <InputText id="reset-confirm-password" @bind-Value="_input.ConfirmPassword" type="password" class="m3-text-field-input" autocomplete="new-password" placeholder=" " />
                    <label class="m3-text-field-label" for="reset-confirm-password">Confirmar contraseña</label>
                    <ValidationMessage For="() => _input.ConfirmPassword" class="m3-validation-error" />
                </div>
                <button type="submit" class="m3-filled-button" disabled="@_busy">@(_busy ? "Guardando…" : "Guardar contraseña")</button>
            </EditForm>
        }
    </section>
</div>

@code {
    private readonly ResetPasswordInput _input = new();
    private string? _requestToken;
    private string? _message;
    private bool _hasCode;
    private bool _busy;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _input.Code = ReadQueryValue("code");
        _hasCode = !string.IsNullOrWhiteSpace(_input.Code);
        if (!_hasCode) return;

        try
        {
            _requestToken = (await Api.GetFromJsonAsync<AntiforgeryResponse>("/api/security/antiforgery"))?.RequestToken;
            if (string.IsNullOrWhiteSpace(_requestToken))
                SetError("No se pudo preparar la solicitud. Inténtalo nuevamente.");
        }
        catch (HttpRequestException)
        {
            SetError("No se pudo preparar la solicitud. Inténtalo nuevamente.");
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            if (string.IsNullOrWhiteSpace(_requestToken))
                throw new InvalidOperationException("No se pudo validar la solicitud.");

            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/identity/auth/reset-password")
            {
                Content = JsonContent.Create(new ResetPasswordRequest(_input.Email, _input.Password, _input.ConfirmPassword, _input.Code))
            };
            request.Headers.Add("RequestVerificationToken", _requestToken);
            using var response = await Api.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/Identity/Account/ResetPasswordConfirmation");
                return;
            }

            var errors = await response.Content.ReadFromJsonAsync<ResetPasswordErrorResponse>();
            _message = errors?.Errors?.FirstOrDefault() ?? "No se pudo restablecer la contraseña. Solicita un nuevo enlace.";
            _isError = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            SetError("No se pudo completar la solicitud. Inténtalo nuevamente.");
        }
        finally { _busy = false; }
    }

    private string ReadQueryValue(string key)
    {
        var query = new Uri(Navigation.Uri).Query;
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (Uri.UnescapeDataString(parts[0].Replace('+', ' ')) == key)
                return parts.Length == 2 ? Uri.UnescapeDataString(parts[1].Replace('+', ' ')) : string.Empty;
        }
        return string.Empty;
    }

    private void SetError(string message)
    {
        _message = message;
        _isError = true;
    }

    private sealed class ResetPasswordInput
    {
        [Required, EmailAddress, StringLength(256)] public string Email { get; set; } = string.Empty;
        [Required, StringLength(100, MinimumLength = 6)] public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password))] public string ConfirmPassword { get; set; } = string.Empty;
        [Required] public string Code { get; set; } = string.Empty;
    }

    private sealed record ResetPasswordRequest(string Email, string Password, string ConfirmPassword, string Code);
    private sealed record ResetPasswordErrorResponse(string Code, IReadOnlyList<string> Errors);
    private sealed record AntiforgeryResponse(string RequestToken);
}
