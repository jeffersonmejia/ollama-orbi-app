@page "/Identity/Account/ForgotPassword"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Api
@inject NavigationManager Navigation

<PageTitle>Recuperar contraseña - Dash</PageTitle>

<div class="orbi-login-page">
    <section class="m3-card orbi-login-card" aria-labelledby="forgot-password-title">
        <h1 id="forgot-password-title">¿Olvidaste tu contraseña?</h1>
        <p>Ingresa el correo electrónico asociado a tu cuenta.</p>
        @if (_message is not null)
        {
            <p class="orbi-auth-message @(_isError ? "error" : string.Empty)" role="@(_isError ? "alert" : "status")">@_message</p>
        }

        <EditForm Model="_input" OnValidSubmit="SubmitAsync" class="orbi-login-form">
            <DataAnnotationsValidator />
            <div class="m3-text-field">
                <InputText id="forgot-email" @bind-Value="_input.Email" class="m3-text-field-input" autocomplete="username" placeholder="correo@ejemplo.com" />
                <label class="m3-text-field-label" for="forgot-email">Correo electrónico</label>
                <ValidationMessage For="() => _input.Email" class="m3-validation-error" />
            </div>
            <button type="submit" class="m3-filled-button" disabled="@_busy">@(_busy ? "Enviando…" : "Restablecer contraseña")</button>
        </EditForm>
        <div class="orbi-login-links"><NavLink href="/Identity/Account/Login">Volver a iniciar sesión</NavLink></div>
    </section>
</div>

@code {
    private readonly ForgotPasswordInput _input = new();
    private string? _requestToken;
    private string? _message;
    private bool _busy;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _requestToken = (await Api.GetFromJsonAsync<AntiforgeryResponse>("/api/security/antiforgery"))?.RequestToken;
            if (string.IsNullOrWhiteSpace(_requestToken))
                SetError("No se pudo preparar la solicitud. Inténtalo nuevamente.");
        }
        catch (HttpRequestException)
        {
            SetError("No se pudo preparar la solicitud. Inténtalo nuevamente.");
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            if (string.IsNullOrWhiteSpace(_requestToken))
                throw new InvalidOperationException("No se pudo validar la solicitud.");

            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/identity/auth/forgot-password")
            {
                Content = JsonContent.Create(new ForgotPasswordRequest(_input.Email))
            };
            request.Headers.Add("RequestVerificationToken", _requestToken);
            using var response = await Api.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/Identity/Account/ForgotPasswordConfirmation");
                return;
            }

            SetError("No se pudo completar la solicitud. Inténtalo nuevamente.");
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            SetError("No se pudo completar la solicitud. Inténtalo nuevamente.");
        }
        finally { _busy = false; }
    }

    private void SetError(string message)
    {
        _message = message;
        _isError = true;
    }

    private sealed class ForgotPasswordInput
    {
        [Required, EmailAddress, StringLength(256)] public string Email { get; set; } = string.Empty;
    }

    private sealed record ForgotPasswordRequest(string Email);
    private sealed record AntiforgeryResponse(string RequestToken);
}
