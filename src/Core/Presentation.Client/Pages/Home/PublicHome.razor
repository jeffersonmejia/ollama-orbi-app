@page "/"
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Inicio - Dash</PageTitle>

@if (!_redirectingToRoleHome)
{
<section class="orbi-home-section orbi-home-public" aria-label="Bienvenido a Dash" aria-busy="@(!_videoReady)">
    <div class="orbi-home-video-shell">
        <video @ref="_video" class="orbi-home-video" autoplay muted loop playsinline preload="auto" aria-label="Presentación de Dash" @oncanplay="HandleVideoReady">
            <source src="/assets/video/home_publicidad.mp4" type="video/mp4" />
            Tu navegador no puede reproducir este video.
        </video>
        @if (!_videoReady)
        {
            <div class="m3-skeleton orbi-home-skeleton" role="status" aria-label="Cargando presentación">
                <span class="orbi-home-skeleton-control" aria-hidden="true"></span>
            </div>
        }
            <button type="button" class="m3-icon-btn orbi-home-video-mute" @onclick="ToggleMuteAsync"
                    aria-label="@(_muted ? "Activar sonido" : "Silenciar video")" title="@(_muted ? "Activar sonido" : "Silenciar video")">
                <span class="material-symbols-outlined" aria-hidden="true">@(_muted ? "volume_off" : "volume_up")</span>
            </button>
    </div>
</section>
}

@code {
    private ElementReference _video;
    private IJSObjectReference? _module;
    private bool _videoReady;
    private bool _muted = true;
    private bool _redirectingToRoleHome;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true && user.IsInRole("Repartidor"))
        {
            _redirectingToRoleHome = true;
            Navigation.NavigateTo("/Delivery/Deliveries", replace: true);
        }
        else if (user.Identity?.IsAuthenticated == true && user.IsInRole("Vendedor"))
        {
            _redirectingToRoleHome = true;
            Navigation.NavigateTo("/Delivery/SellerStore", replace: true, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _redirectingToRoleHome) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/Pages/Home/PublicHome.razor.js");
        await _module.InvokeVoidAsync("setMuted", _video, _muted);
    }

    private void HandleVideoReady() => _videoReady = true;

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;
        if (_module is not null)
            await _module.InvokeVoidAsync("setMuted", _video, _muted);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
