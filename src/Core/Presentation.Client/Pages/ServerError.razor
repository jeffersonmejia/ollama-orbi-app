@page "/500"
<PageTitle>Error interno - Dash</PageTitle>
<section class="orbi-route-error" role="alert">
    <span class="material-symbols-outlined" aria-hidden="true">error</span>
    <p class="orbi-error-code">500</p>
    <h1>Ocurrió un error</h1>
    <p>No pudimos completar la solicitud. Intenta de nuevo más tarde.</p>
    <LegacyNavigationLink Href="/" Class="m3-filled-button">Volver al inicio</LegacyNavigationLink>
</section>
