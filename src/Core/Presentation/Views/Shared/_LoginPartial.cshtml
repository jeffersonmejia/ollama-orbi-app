@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="orbi-auth-links">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <span class="orbi-auth-link">@UserManager.GetUserName(User)</span>
    </li>
}
else
{
    <li>
        <a class="orbi-auth-link" id="register" href="/registro">Sign Up</a>
    </li>
    <li>
        <a class="orbi-auth-link" id="login" href="/Identity/Account/Login">Sign In</a>
    </li>
}
</ul>
