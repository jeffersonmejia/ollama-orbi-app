@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isAssistantPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Assistant";
    var contextKey = "public_home";
    var welcome = "Hola, soy el asistente de Dash. Puedo ayudarte a conocer la aplicación, sus tiendas y productos.";
    string[] suggestions = { "¿Qué puedo hacer en Dash?", "¿Qué productos hay?" };

    if (page.EndsWith("/Login", StringComparison.OrdinalIgnoreCase))
    {
        contextKey = "login";
        welcome = "¿Tienes problemas para iniciar sesión? Cuéntame qué ocurre y te ayudo.";
        suggestions = new[] { "Olvidé mi contraseña", "No puedo ingresar" };
    }
    else if (page.EndsWith("/Register", StringComparison.OrdinalIgnoreCase))
    {
        contextKey = "register";
        welcome = "Puedo ayudarte a crear tu cuenta y elegir el rol adecuado.";
        suggestions = new[] { "¿Qué rol debo elegir?", "¿Qué contraseña necesito?" };
    }
    else if (page.EndsWith("/Logout", StringComparison.OrdinalIgnoreCase))
    {
        contextKey = "logout";
        welcome = "¿Necesitas ayuda para cerrar sesión o volver a ingresar? Cuéntame.";
        suggestions = new[] { "¿Cómo cierro mi sesión?", "Quiero cambiar de cuenta" };
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        if (User.IsInRole("Administrador"))
        {
            contextKey = "administrador";
            welcome = "Hola. Puedo ayudarte con tiendas, pedidos, usuarios y la administración de Dash.";
            suggestions = new[] { "¿Cómo reviso los pedidos?", "¿Cuántos roles existen?" };
        }
        else if (User.IsInRole("Vendedor"))
        {
            contextKey = "vendedor";
            welcome = "Hola. Puedo orientarte con el catálogo, las tiendas y la operación comercial.";
            suggestions = new[] { "¿Qué productos están disponibles?", "¿Qué tiendas están activas?" };
        }
        else if (User.IsInRole("Repartidor"))
        {
            contextKey = "repartidor";
            welcome = "Hola. Puedo ayudarte a consultar tus entregas y actualizar su estado.";
            suggestions = new[] { "¿Dónde veo mis entregas?", "¿Cómo marco una entrega?" };
        }
        else
        {
            contextKey = "usuario";
            welcome = "Hola. Puedo ayudarte a encontrar productos, hacer pedidos y revisar su estado.";
            suggestions = new[] { "¿Qué productos hay?", "¿Cómo hago un pedido?" };
        }
    }

    if (isAssistantPage)
    {
        suggestions = contextKey switch
        {
            "administrador" => new[] { "¿Cómo reviso los pedidos?", "¿Cómo administro las tiendas?", "¿Cómo gestiono los usuarios?" },
            "vendedor" => new[] { "¿Qué productos están disponibles?", "¿Cómo actualizo el inventario?", "¿Cómo reviso mis ventas?" },
            "repartidor" => new[] { "¿Dónde veo mis entregas?", "¿Cómo actualizo una entrega?", "¿Qué estados puede tener un pedido?" },
            _ => new[] { "¿Qué productos hay?", "¿Cómo hago un pedido?", "¿Qué métodos de pago aceptan?" }
        };
    }
}

<style>
    .orbi-chat-panel {
        position: fixed; inset: 0 auto 0 80px; z-index: 45; width: 340px; height: 100vh;
        padding: 18px; box-sizing: border-box; border-right: 1px solid var(--md-sys-color-outline-variant);
        background: #ffffff; display: none; flex-direction: column; min-width: 0;
    }
    .orbi-chat-panel.open { display:flex; }
    .orbi-chat-body { min-height: 0; flex: 1; display: flex; flex-direction: column; }
    .orbi-chat-message { width: fit-content; max-width: 86%; padding: 9px 12px; margin-bottom: 10px; border-radius: var(--md-sys-shape-corner-medium); line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
    .orbi-chat-message-user { margin-left: auto; border-bottom-right-radius: 4px; background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
    .orbi-chat-message-assistant { margin-right: auto; border-bottom-left-radius: 4px; background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }
    .orbi-chat-message-streaming::after { content:'▋'; margin-left:2px; color:var(--md-sys-color-primary); animation:orbi-chat-cursor .75s steps(1) infinite; }
    .orbi-chat-suggestions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 7px; padding: 2px 1px 10px; }
    .orbi-chat-suggestion { width:100%; min-width:0; padding: 7px 9px; border: 0; border-radius: 16px; background: var(--md-sys-color-surface-container); color: var(--md-sys-color-on-surface); font: inherit; font-size: 12px; font-weight: 500; line-height: 1.3; cursor: pointer; white-space: normal; transition: background-color var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard), color var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard); }
    .orbi-chat-suggestion:hover { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
    .orbi-chat-suggestion:focus-visible { outline: none; }
    .orbi-chat-typing span { display: inline-block; min-width: .22em; animation: orbi-chat-dot 1.2s infinite ease-in-out; }
    .orbi-chat-typing span:nth-child(2) { animation-delay: .15s; } .orbi-chat-typing span:nth-child(3) { animation-delay: .3s; }
    .orbi-chat-composer { display: flex; align-items: center; gap: 8px; width:100%; box-sizing:border-box; padding: 6px 7px 6px 14px; border: 0; border-radius: 24px; background: var(--md-sys-color-surface-container); }
    .orbi-chat-composer:focus-within { background: var(--md-sys-color-surface-container-high); box-shadow: none; }
    .orbi-chat-input { display:block; flex: 1 1 0%; width:100%; min-width:0; min-height:40px; max-height:112px; margin:0; padding:8px 2px; border:0 !important; outline:0 !important; box-shadow:none !important; resize:none; overflow-y:auto; scrollbar-width:none; background:transparent; color:var(--md-sys-color-on-surface); font:inherit; line-height:1.4; }
    .orbi-chat-input:focus { border:0 !important; outline:0 !important; box-shadow:none !important; }
    .orbi-chat-suggestions[hidden] { display:none !important; }
    .orbi-chat-input::-webkit-scrollbar { display: none; }
    @@keyframes orbi-chat-dot { 0%,60%,100% { transform:translateY(0);opacity:.35 } 30% { transform:translateY(-3px);opacity:1 } }
    @@keyframes orbi-chat-cursor { 0%,45% { opacity:1; } 46%,100% { opacity:0; } }
    @@media (max-width: 900px) {
        .orbi-chat-panel { inset:0 0 72px 0; width:min(340px,100vw); z-index:60; box-shadow:4px 0 18px rgba(0,0,0,.18); }
    }
</style>

<aside id="orbi-chat-panel" class="orbi-chat-panel @(isAssistantPage ? "open orbi-chat-page-panel" : "")" data-welcome="@welcome" data-fullscreen="@isAssistantPage.ToString().ToLowerInvariant()" aria-label="Asistente Dash">
    <div class="orbi-chat-header" style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
        @if (!isAssistantPage)
        {
            <span class="orbi-chat-brand material-symbols-outlined" style="color:var(--md-sys-color-primary);">smart_toy</span>
            <strong class="orbi-chat-brand" style="flex:1;">Asistente Dash</strong>
        }
        else
        {
            <span class="orbi-chat-page-header-spacer" aria-hidden="true"></span>
        }
        @if (isAssistantPage)
        {
            <button id="orbi-chat-new" type="button" class="m3-filled-button orbi-chat-new-button">
                <span class="material-symbols-outlined" aria-hidden="true">add</span>
                <span>Nuevo chat</span>
            </button>
        }
        else
        {
            <button id="orbi-chat-new" type="button" class="m3-icon-btn" aria-label="Nuevo chat" title="Nuevo chat"><span class="material-symbols-outlined">add_comment</span></button>
            <button id="orbi-chat-toggle" type="button" class="m3-icon-btn" aria-expanded="true" aria-controls="orbi-chat-body" aria-label="Cerrar asistente" title="Cerrar asistente"><span class="material-symbols-outlined">chevron_left</span></button>
        }
    </div>
    <div id="orbi-chat-body" class="orbi-chat-body">
        <div id="orbi-chat-messages" aria-live="polite" style="flex:1;min-height:180px;overflow-y:auto;padding:8px 4px;font-size:var(--md-sys-typescale-body-small-size);margin-bottom:8px;">
            @if (isAssistantPage)
            {
                <template id="orbi-chat-empty-state-template">
                    <div class="orbi-chat-empty-state">
                        <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                        <h1>¿En qué te ayudo hoy?</h1>
                        <p>@welcome</p>
                    </div>
                </template>
                <div class="orbi-chat-empty-state" id="orbi-chat-empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                    <h1>¿En qué te ayudo hoy?</h1>
                    <p>@welcome</p>
                </div>
            }
            else
            {
                <div class="orbi-chat-message orbi-chat-message-assistant">@welcome</div>
            }
        </div>
        <div class="orbi-chat-suggestions" aria-label="Preguntas sugeridas">
            @foreach (var suggestion in suggestions)
            {
                <button type="button" class="orbi-chat-suggestion" data-question="@suggestion">@suggestion</button>
            }
        </div>
        <form id="orbi-chat-form" class="orbi-chat-composer" method="post" asp-area="" asp-controller="Home" asp-action="ProductChat">
            <input type="hidden" name="context" value="@contextKey" />
            <textarea id="orbi-chat-input" class="orbi-chat-input" name="message" rows="1" maxlength="500" required placeholder="Escribe tu pregunta..." aria-label="Mensaje para el asistente"></textarea>
            <button id="orbi-chat-send" class="m3-filled-button" type="submit" aria-label="Enviar mensaje" title="Enviar" style="width:44px;padding:0;flex:0 0 44px;">
                <svg class="orbi-chat-send-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5m-7 7 7-7 7 7" /></svg>
                <svg class="orbi-chat-send-stop" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M7 7h10v10H7z" /></svg>
            </button>
        </form>
    </div>
</aside>

<script>
(() => {
    const panel = document.getElementById('orbi-chat-panel');
    const form = document.getElementById('orbi-chat-form');
    if (!panel || !form) return;
    const input = document.getElementById('orbi-chat-input');
    const messages = document.getElementById('orbi-chat-messages');
    const suggestions = panel.querySelector('.orbi-chat-suggestions');
    const send = document.getElementById('orbi-chat-send');
    const sendArrow = send.querySelector('.orbi-chat-send-arrow');
    const sendStop = send.querySelector('.orbi-chat-send-stop');
    let controller = null;

    const addMessage = (text, user = false) => {
        document.getElementById('orbi-chat-empty-state')?.remove();
        const element = document.createElement('div');
        element.className = `orbi-chat-message ${user ? 'orbi-chat-message-user' : 'orbi-chat-message-assistant'}`;
        element.textContent = text;
        messages.appendChild(element);
        messages.scrollTop = messages.scrollHeight;
        return element;
    };

    const resize = () => { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 112) + 'px'; };
    input.addEventListener('input', resize);
    input.addEventListener('keydown', event => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); if (!controller) form.requestSubmit(); } });
    panel.querySelectorAll('.orbi-chat-suggestion').forEach(button => button.addEventListener('click', () => { input.value = button.dataset.question; resize(); form.requestSubmit(); }));

    document.getElementById('orbi-chat-new').addEventListener('click', () => {
        controller?.abort(); controller = null; messages.replaceChildren(); suggestions.hidden = false;
        const emptyState = document.getElementById('orbi-chat-empty-state-template');
        if (panel.dataset.fullscreen === 'true' && emptyState) messages.appendChild(emptyState.content.cloneNode(true));
        else addMessage(panel.dataset.welcome);
        input.value = ''; resize(); send.type = 'submit'; sendArrow.hidden = false; sendStop.hidden = true; input.disabled = false;
    });

    send.addEventListener('click', () => { if (controller) controller.abort(); });
    form.addEventListener('submit', async event => {
        event.preventDefault();
        const text = input.value.trim(); if (text.length < 2) return;
        const data = new FormData(form); suggestions.hidden = true; addMessage(text, true); input.value = ''; resize();
        controller = new AbortController(); send.type = 'button'; sendArrow.hidden = true; sendStop.hidden = false; input.disabled = true;
        const typing = addMessage('Pensando');
        typing.classList.add('orbi-chat-typing');
        typing.setAttribute('aria-label', 'Pensando...');
        typing.append(' ');
        for (let index = 0; index < 3; index++) {
            const dot = document.createElement('span');
            dot.textContent = '.';
            typing.appendChild(dot);
        }
        try {
            const response = await fetch(form.action, { method: 'POST', body: data, signal: controller.signal });
            if (!response.body) throw new Error('El navegador no admite respuestas progresivas.');

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';
            let answer = '';
            let serverError = '';
            let assistantMessage = null;

            const showAnswer = value => {
                typing.remove();
                if (!assistantMessage) {
                    assistantMessage = addMessage('');
                    assistantMessage.classList.add('orbi-chat-message-streaming');
                }
                assistantMessage.textContent = value;
                messages.scrollTop = messages.scrollHeight;
            };
            const processLine = line => {
                if (!line.trim()) return;
                const eventData = JSON.parse(line);
                if (eventData.type === 'status') {
                    typing.textContent = eventData.content || 'Procesando...';
                    typing.classList.remove('orbi-chat-typing');
                } else if (eventData.type === 'delta') {
                    answer += eventData.content || '';
                    showAnswer(answer);
                } else if (eventData.type === 'final') {
                    answer = eventData.content || answer;
                    showAnswer(answer);
                } else if (eventData.type === 'error') {
                    serverError = eventData.content || 'No pude responder.';
                    showAnswer(serverError);
                }
            };

            while (true) {
                const { value, done } = await reader.read();
                buffer += decoder.decode(value || new Uint8Array(), { stream: !done });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';
                lines.forEach(processLine);
                if (done) break;
            }
            if (buffer.trim()) processLine(buffer);
            typing.remove();
            assistantMessage?.classList.remove('orbi-chat-message-streaming');
            if (!assistantMessage) assistantMessage = addMessage(serverError || answer || 'No pude responder.');
        } catch (error) {
            typing.remove(); const errorText = error.name === 'AbortError' ? 'Respuesta detenida.' : 'No pude conectar con el asistente.'; addMessage(errorText);
        } finally {
            controller = null; send.type = 'submit'; sendArrow.hidden = false; sendStop.hidden = true; input.disabled = false; input.focus();
        }
    });
})();
</script>
