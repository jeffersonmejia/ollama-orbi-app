<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Orbi App</title>
    <link rel="stylesheet" href="~/css/m3/m3-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delivery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile-addresses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var currentUserRole = string.Empty;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null)
        {
            currentUserRole = (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault() ?? "Sin rol";
        }
    }
    var navPreferenceKey = SignInManager.IsSignedIn(User)
        ? UserManager.GetUserId(User)
        : "anonymous";
}
<div class="m3-app-layout" id="m3-app-layout" data-nav-preference-key="@navPreferenceKey">
    <nav class="m3-nav-rail" id="m3-nav-rail" aria-label="Navegación principal">
        <div class="m3-nav-rail-header">
            <a class="m3-nav-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orbi" title="Orbi">
                <span class="m3-nav-brand-mark material-symbols-outlined" aria-hidden="true">shopping_bag</span>
                <span class="m3-nav-brand-label">Orbi</span>
            </a>
            <button class="m3-icon-btn m3-nav-toggle" id="m3-nav-toggle" type="button"
                    aria-label="Contraer navegación" aria-controls="m3-nav-rail" aria-expanded="true"
                    title="Contraer navegación">
                <span class="material-symbols-outlined" aria-hidden="true">left_panel_close</span>
            </button>
        </div>

        <ul class="m3-nav-items">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li>
                    <a class="m3-nav-item @(currentController == "Home" && currentAction == "Assistant" ? "active" : "")"
                       asp-area="" asp-controller="Home" asp-action="Assistant">
                        <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                        <span>Asistente</span>
                    </a>
                </li>
                <li>
                <a class="m3-nav-item @(currentController == "Delivery" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Delivery" asp-action="Index">
                        <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
                        <span>Tiendas</span>
                    </a>
                </li>
                @if (User.IsInRole("Usuario"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="MyOrders"><span class="material-symbols-outlined" aria-hidden="true">receipt_long</span><span>Pedidos</span></a></li>
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="MyPayments"><span class="material-symbols-outlined" aria-hidden="true">payments</span><span>Pagos</span></a></li>
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="Cart"><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span><span>Carrito</span></a></li>
                }
                @if (User.IsInRole("Repartidor"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="Deliveries"><span class="material-symbols-outlined" aria-hidden="true">delivery_dining</span><span>Entregas</span></a></li>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="Admin"><span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span><span>Admin</span></a></li>
                }
                <li>
                <a class="m3-nav-item orbi-operation-nav-item @(currentController == "Operations" ? "active" : "")"
                       asp-controller="@(User.IsInRole("Vendedor") ? "Delivery" : "Operations")" asp-action="@(User.IsInRole("Vendedor") ? "SellerInventory" : User.IsInRole("Administrador") ? "DeliveryIncidents" : "Index")">
                        <span class="material-symbols-outlined" aria-hidden="true">monitoring</span>
                        <span>@(User.IsInRole("Administrador") ? "Operación" : User.IsInRole("Vendedor") ? "Inventario" : "Seguimiento")</span>
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="m3-nav-item @(currentPage?.EndsWith("/Login", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" asp-area="Identity" asp-page="/Account/Login">
                        <span class="material-symbols-outlined" aria-hidden="true">login</span>
                        <span>Iniciar sesión</span>
                    </a>
                </li>
                <li>
                    <a class="m3-nav-item @(currentPage?.EndsWith("/Register", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" asp-area="Identity" asp-page="/Account/Register">
                        <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
                        <span>Registro</span>
                    </a>
                </li>
            }
        </ul>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="m3-nav-rail-footer">
                <a class="m3-nav-item orbi-profile-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index"
                   title="@UserManager.GetUserName(User)">
                    <span class="material-symbols-outlined" aria-hidden="true">person</span>
                    <span class="orbi-profile-label">
                        <span>Perfil</span>
                        <small>@currentUserRole</small>
                    </span>
                </a>
            </div>
        }
    </nav>

    <div class="m3-content-area @(currentController == "Home" && currentAction == "Assistant" ? "orbi-assistant-content-area" : string.Empty)">
        <main class="m3-main @(currentController == "Home" && User.Identity?.IsAuthenticated != true ? "orbi-public-home-main" : string.Empty) @(currentController == "Home" && currentAction == "Assistant" ? "orbi-assistant-main" : string.Empty)">
            @RenderBody()
        </main>

        <footer class="m3-footer @(currentController == "Home" && currentAction == "Assistant" ? "orbi-assistant-footer" : string.Empty)">
            &copy; 2026 Orbi. Todos los derechos reservados.
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/m3.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
