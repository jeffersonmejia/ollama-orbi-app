<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OrbiApp.Presentation</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>14736bf1-7d58-44b5-824f-60225a3b645d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="RazorShared/_ViewImports.cshtml" Link="Features/_ViewImports.cshtml" />
    <Content Update="RazorShared/_ViewStart.cshtml" Link="Features/_ViewStart.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Program.cs" Link="Program.cs" />
    <Compile Include="../../Features/**/Presentation/**/*.cs" />
    <ProjectReference Include="../Presentation.Client/Presentation.Client.csproj" />
    <Content Include="../../Features/**/*.cshtml"
             Exclude="../../Features/Identity/Presentation/Areas/Identity/Pages/**/*.cshtml"
             Link="Features/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../Features/Identity/Presentation/Areas/Identity/Pages/**/*.cshtml"
             Link="Areas/Identity/Pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Application/Application.csproj" />
    <ProjectReference Include="../Infrastructure/Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../Features/Shared/Infrastructure/Sql/orbi-*.sql" Link="db/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

