@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="orbi-account-page">
    <header class="orbi-account-identity">
        <div class="orbi-account-avatar">@((Model.Username ?? "U")[..1].ToUpperInvariant())</div>
        <h1>@Model.Username</h1>
        <span>@Model.RoleSummary</span>
    </header>

    <partial name="_StatusMessage" for="StatusMessage" />

    <section class="orbi-google-card">
        <div class="orbi-google-card-heading">
            <div><h2>Información personal</h2><p>Datos básicos asociados a tu cuenta de Orbi.</p></div>
            <span class="material-symbols-outlined">person</span>
        </div>
        <form id="profile-form" method="post" class="orbi-account-rows">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="orbi-account-row">
                <label>Correo</label>
                <span>@Model.Username</span>
                <span class="material-symbols-outlined">lock</span>
            </div>
            <div class="orbi-account-row orbi-account-row-editable">
                <label asp-for="Input.PhoneNumber"></label>
                <input asp-for="Input.PhoneNumber" placeholder="Agregar número de contacto" />
                <button type="submit" class="m3-text-button">Guardar</button>
            </div>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </form>
    </section>

    <a asp-page="./Addresses" class="orbi-google-card orbi-account-link-card">
        <span class="material-symbols-outlined">location_on</span>
        <div><h2>Direcciones</h2><p>Administra tus lugares de entrega.</p></div>
        <span class="material-symbols-outlined">chevron_right</span>
    </a>
</div>
