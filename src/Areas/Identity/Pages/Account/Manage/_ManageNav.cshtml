@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="orbi-account-nav">
    <a class="@(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "active" : "")" id="profile" asp-page="./Index"><span class="material-symbols-outlined">person</span><span>Perfil</span></a>
    <a class="@(ManageNavPages.AddressesNavClass(ViewContext) == "active" ? "active" : "")" id="addresses" asp-page="./Addresses"><span class="material-symbols-outlined">location_on</span><span>Direcciones</span></a>
    <a class="@(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "active" : "")" id="email" asp-page="./Email"><span class="material-symbols-outlined">mail</span><span>Correo</span></a>
    <a class="@(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "active" : "")" id="change-password" asp-page="./ChangePassword"><span class="material-symbols-outlined">password</span><span>Clave</span></a>
    @if (hasExternalLogins)
    {
        <a class="@(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "active" : "")" id="external-login" asp-page="./ExternalLogins"><span class="material-symbols-outlined">link</span><span>Accesos externos</span></a>
    }
    <a class="@(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "active" : "")" id="two-factor" asp-page="./TwoFactorAuthentication"><span class="material-symbols-outlined">security</span><span>Doble factor</span></a>
    <a class="@(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "active" : "")" id="personal-data" asp-page="./PersonalData"><span class="material-symbols-outlined">database</span><span>Datos</span></a>
</nav>
