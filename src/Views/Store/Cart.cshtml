@model IEnumerable<SakilaApp.Models.Commerce.ShoppingCartItem>

@{
    var total = Model.Sum(i => i.Quantity * i.FilmStock.UnitPrice);
}

<div class="m3-page">
    <h1 class="m3-page-title">Cart</h1>

    @if (TempData["Error"] != null)
    {
        <div style="font-size:var(--md-sys-typescale-body-small-size);color:var(--md-sys-color-error);margin-bottom:1rem;">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="m3-card" style="text-align:center;padding:3rem 2rem;color:var(--md-sys-color-on-surface-variant);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;margin-bottom:1rem;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <p style="font-size:var(--md-sys-typescale-body-large-size);margin:0;">Your cart is empty</p>
            <a class="m3-filled-button" asp-action="Index" style="margin-top:1.5rem;">Go to store</a>
        </div>
    }
    else
    {
        <div class="m3-card" style="overflow:hidden;padding:0;">
            <table style="width:100%;border-collapse:collapse;font-size:var(--md-sys-typescale-body-medium-size);">
                <thead>
                    <tr style="background:var(--md-sys-color-surface-container-highest);color:var(--md-sys-color-on-surface-variant);font-weight:var(--md-sys-typescale-label-medium-weight);font-size:var(--md-sys-typescale-label-medium-size);">
                        <th style="text-align:left;padding:16px;">Film</th>
                        <th style="text-align:center;padding:16px;">Quantity</th>
                        <th style="text-align:right;padding:16px;">Price</th>
                        <th style="text-align:right;padding:16px;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-top:1px solid var(--md-sys-color-outline-variant);">
                            <td style="padding:16px;color:var(--md-sys-color-on-surface);font-weight:500;">@item.FilmStock.Title</td>
                            <td style="text-align:center;padding:16px;color:var(--md-sys-color-on-surface);">@item.Quantity</td>
                            <td style="text-align:right;padding:16px;color:var(--md-sys-color-on-surface-variant);">@item.FilmStock.UnitPrice.ToString("C")</td>
                            <td style="text-align:right;padding:16px;color:var(--md-sys-color-on-surface);font-weight:600;">@((item.Quantity * item.FilmStock.UnitPrice).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1.5rem;flex-wrap:wrap;gap:1rem;">
            <h3 style="font-size:var(--md-sys-typescale-title-large-size);font-weight:var(--md-sys-typescale-title-large-weight);color:var(--md-sys-color-on-surface);margin:0;">Total: @total.ToString("C")</h3>

            <form asp-action="Checkout" method="post">
                <input type="hidden" name="provider" value="PayPhone" />
                <button class="m3-filled-button" style="font-size:16px;padding:0 24px;height:48px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;margin-right:8px;"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                    Pay with PayPhone
                </button>
            </form>

            <form asp-action="Checkout" method="post">
                <input type="hidden" name="provider" value="PayPal" />
                <button class="m3-filled-button" style="font-size:16px;padding:0 24px;height:48px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;margin-right:8px;"><path d="M6 7h11a4 4 0 0 1 0 8H9"/><path d="M9 11l-3 4"/><path d="M9 15l-3-4"/></svg>
                    Pay with PayPal
                </button>
            </form>

            <form asp-action="CheckoutPayPalButton" method="post">
                <button class="m3-filled-button" style="font-size:16px;padding:0 24px;height:48px;background:var(--md-sys-color-surface-container-highest);color:var(--md-sys-color-on-surface);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;margin-right:8px;"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    Pay with PayPal / Card (Sandbox)
                </button>
            </form>
        </div>
    }

    <div style="margin-top:1rem;">
        <a class="m3-text-button" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;margin-right:4px;"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
            Continue shopping
        </a>
    </div>
</div>
