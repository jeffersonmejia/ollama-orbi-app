@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Orbi";
    var chatContext = "public_home";
    var chatWelcome = "Hola, soy el asistente de Orbi. Puedo ayudarte a conocer la aplicación, sus tiendas y productos.";
    string[] chatSuggestions = { "¿Qué puedo hacer en Orbi?", "¿Qué productos hay?" };
    string[] roleMessages =
    {
        "¿Qué quieres pedir hoy?",
        "Tus tiendas favoritas están cerca",
        "Explora productos disponibles",
        "Recibe tu pedido en tu dirección favorita"
    };

    if (User.IsInRole("Administrador"))
    {
        roleMessages = Array.Empty<string>();
        chatContext = "administrador";
        chatWelcome = "Hola. Puedo ayudarte con tiendas, pedidos, usuarios y la administración de Orbi.";
        chatSuggestions = new[] { "¿Cómo reviso los pedidos?", "¿Cuántos roles existen?" };
    }
    else if (User.IsInRole("Vendedor"))
    {
        roleMessages = new[] { "Mantén el inventario al día", "Registra movimientos de productos", "Controla las reservas de stock", "Impulsa las ventas de tu tienda" };
        chatContext = "vendedor";
        chatWelcome = "Hola. Puedo orientarte con el catálogo, las tiendas y la operación comercial.";
        chatSuggestions = new[] { "¿Qué productos están disponibles?", "¿Qué tiendas están activas?" };
    }
    else if (User.IsInRole("Repartidor"))
    {
        roleMessages = new[] { "Tus entregas están listas", "Actualiza el estado de cada pedido", "Reporta incidencias en ruta", "Entrega cada pedido a tiempo" };
        chatContext = "repartidor";
        chatWelcome = "Hola. Puedo ayudarte a consultar tus entregas y actualizar su estado.";
        chatSuggestions = new[] { "¿Dónde veo mis entregas?", "¿Cómo marco una entrega?" };
    }
    else if (User.IsInRole("Usuario"))
    {
        chatContext = "usuario";
        chatWelcome = "Hola. Puedo ayudarte a encontrar productos, hacer pedidos y revisar su estado.";
        chatSuggestions = new[] { "¿Qué productos hay?", "¿Cómo hago un pedido?" };
    }
}

