@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Orbi";
    var chatContext = "public_home";
    var chatWelcome = "Hola, soy el asistente de Orbi. Puedo ayudarte a conocer la aplicación, sus tiendas y productos.";
    string[] chatSuggestions = { "¿Qué puedo hacer en Orbi?", "¿Qué productos hay?" };
    string[] roleMessages =
    {
        "¿Qué quieres pedir hoy?",
        "Tus tiendas favoritas están cerca",
        "Explora productos disponibles",
        "Recibe tu pedido en tu dirección favorita"
    };

    if (User.IsInRole("Administrador"))
    {
        roleMessages = new[] { "Controla la operación de Orbi", "Revisa pedidos e incidencias", "Consulta inventario y auditoría", "Gestiona tiendas y entregas" };
        chatContext = "administrador";
        chatWelcome = "Hola. Puedo ayudarte con tiendas, pedidos, usuarios y la administración de Orbi.";
        chatSuggestions = new[] { "¿Cómo reviso los pedidos?", "¿Cuántos roles existen?" };
    }
    else if (User.IsInRole("Vendedor"))
    {
        roleMessages = new[] { "Mantén el inventario al día", "Registra movimientos de productos", "Controla las reservas de stock", "Impulsa las ventas de tu tienda" };
        chatContext = "vendedor";
        chatWelcome = "Hola. Puedo orientarte con el catálogo, las tiendas y la operación comercial.";
        chatSuggestions = new[] { "¿Qué productos están disponibles?", "¿Qué tiendas están activas?" };
    }
    else if (User.IsInRole("Repartidor"))
    {
        roleMessages = new[] { "Tus entregas están listas", "Actualiza el estado de cada pedido", "Reporta incidencias en ruta", "Entrega cada pedido a tiempo" };
        chatContext = "repartidor";
        chatWelcome = "Hola. Puedo ayudarte a consultar tus entregas y actualizar su estado.";
        chatSuggestions = new[] { "¿Dónde veo mis entregas?", "¿Cómo marco una entrega?" };
    }
    else if (User.IsInRole("Usuario"))
    {
        chatContext = "usuario";
        chatWelcome = "Hola. Puedo ayudarte a encontrar productos, hacer pedidos y revisar su estado.";
        chatSuggestions = new[] { "¿Qué productos hay?", "¿Cómo hago un pedido?" };
    }
}

<style>
    .orbi-home-layout {
        display: block;
        padding-right: 0;
    }

    .orbi-home-section {
        min-width: 0;
        padding: 3rem 1rem 4rem;
        text-align: center;
    }

    .m3-main.orbi-public-home-main {
        max-width: none;
        padding: 8px;
    }

    .orbi-home-section.orbi-home-public {
        padding: 0;
    }

    .orbi-home-video-shell {
        position: relative;
        width: 100%;
        margin: 0;
        border-radius: var(--md-sys-shape-corner-large);
        box-shadow: var(--md-sys-elevation-level2);
        overflow: hidden;
        background: #000;
    }

    .orbi-home-video {
        display: block;
        width: 100%;
        height: calc(100vh - 88px);
        min-height: 420px;
        max-height: 760px;
        object-fit: cover;
        opacity: .72;
    }

    .orbi-home-video-actions {
        position: absolute;
        right: 64px;
        bottom: 16px;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        transform: none;
    }

    .orbi-home-video-action {
        display: inline-flex;
        min-height: 46px;
        padding: 0 22px;
        border: 2px solid #fff;
        border-radius: 999px;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-decoration: none !important;
        transition: transform 150ms ease, background 150ms ease, color 150ms ease;
    }

    .orbi-home-video-action:hover,
    .orbi-home-video-action:focus,
    .orbi-home-video-action:active {
        transform: translateY(-2px);
        text-decoration: none !important;
    }

    .orbi-home-video-action-primary {
        color: #171717;
        background: #fff;
    }

    .orbi-home-video-action-secondary {
        color: #fff;
        background: transparent;
    }

    .orbi-home-video-action-secondary:hover {
        color: #171717;
        background: #fff;
    }

    .orbi-home-video-mute {
        position: absolute;
        right: 16px;
        bottom: 16px;
        color: #fff;
        background: rgba(0, 0, 0, .62);
        backdrop-filter: blur(8px);
    }

    .orbi-home-video-mute:hover {
        background: rgba(0, 0, 0, .78);
    }

    @@media (max-width: 560px) {
        .m3-main.orbi-public-home-main {
            padding: 4px;
        }

        .orbi-home-video {
            height: calc(100vh - 132px);
            min-height: 360px;
        }

        .orbi-home-video-actions {
            right: 56px;
            bottom: 12px;
            gap: 6px;
        }

        .orbi-home-video-action {
            min-height: 40px;
            padding: 0 12px;
            font-size: 12px;
        }

        .orbi-home-video-mute {
            right: 10px;
            bottom: 12px;
        }
    }

