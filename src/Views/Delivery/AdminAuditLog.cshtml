@using SakilaApp.Models.Operations
@model SakilaApp.Models.PaginatedList<AuditLog>
@{ ViewData["Title"] = "Auditoría"; ViewData["PaginatedList"] = Model; }

<div class="orbi-account-shell orbi-delivery-admin-shell">
    <header class="orbi-account-shell-header"><h1>Administración</h1><p>Gestiona tiendas y pedidos de Orbi.</p></header>
    <div class="orbi-account-layout">
        <aside><partial name="_AdminNav" /></aside>
        <main class="orbi-account-main">
            <section class="orbi-account-section">
                <header class="orbi-account-section-header">
                    <div><span class="material-symbols-outlined orbi-section-icon">shield</span><h2>Auditoría</h2></div>
                    <p>Registro de acciones realizadas en el sistema.</p>
                </header>
                <div class="orbi-account-section-content">
                    @if (TempData["Success"] is string success) { <div class="orbi-alert">@success</div> }
                    <form asp-action="AdminAuditLog" method="get" style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:flex-end;">
                        <div class="m3-text-field" style="margin:0;flex:1;min-width:180px;">
                            <label class="m3-text-field-label">Buscar</label>
                            <input type="search" name="buscar" value="@ViewBag.Buscar" class="m3-text-field-input" placeholder="Acción, entidad, usuario..." style="height:40px;" />
                        </div>
                        <button type="submit" class="m3-filled-button" style="height:40px;padding:0 16px;">Buscar</button>
                        <a asp-action="AdminAuditLog" class="m3-text-button" style="height:40px;line-height:40px;">Limpiar</a>
                    </form>
                    <div class="orbi-admin-table-card">
                        <div class="orbi-orders-table-wrap">
                            <table class="m3-data-table orbi-orders-table">
                                <thead><tr><th>Fecha</th><th>Acción</th><th>Entidad</th><th>Entidad ID</th><th>Usuario</th><th>IP</th></tr></thead>
                                <tbody>
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td><strong>@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></td>
                                        <td><span class="orbi-order-status is-preparing"><span class="orbi-status-dot"></span>@log.Action</span></td>
                                        <td>@log.EntityType</td>
                                        <td>@(log.EntityId ?? "—")</td>
                                        <td>@(log.User?.Email ?? "Sistema")</td>
                                        <td><small>@(log.IpAddress ?? "—")</small></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <partial name="_Pagination" />
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>
