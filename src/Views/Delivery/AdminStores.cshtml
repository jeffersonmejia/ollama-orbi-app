@using SakilaApp.Models.Delivery
@using SakilaApp.Models.Identity
@model SakilaApp.Models.PaginatedList<DeliveryStore>
@{
    ViewData["Title"] = "Tiendas";
    ViewData["PaginatedList"] = Model;
    var storeOwners = ViewBag.StoreOwners as IReadOnlyDictionary<int, string>
        ?? new Dictionary<int, string>();
    var storeOwnerDetails = ViewBag.StoreOwnerDetails as IReadOnlyDictionary<int, StoreOwnerOption>
        ?? new Dictionary<int, StoreOwnerOption>();
}

<div class="orbi-account-shell orbi-delivery-admin-shell">
    <header class="orbi-account-shell-header"><h1>Administración</h1><p>Gestiona tiendas y pedidos de Orbi.</p></header>
    <div class="orbi-account-layout">
        <aside><partial name="_AdminNav" /></aside>
        <main class="orbi-account-main">
            <section class="orbi-account-section">
                <header class="orbi-account-section-header">
                    <div>
                        <span class="material-symbols-outlined orbi-section-icon">storefront</span>
                        <h2>Tiendas</h2>
                    </div>
                    <p>Edita la información y controla su disponibilidad.</p>
                </header>
                <div class="orbi-account-section-content">
                    @if (TempData["Success"] is string success) { <div class="orbi-alert">@success</div> }
                    @if (TempData["Error"] is string error) { <div class="orbi-alert orbi-alert-error">@error</div> }

                    <div class="orbi-admin-stack">
                        <section id="edit-store-section" class="m3-card orbi-admin-edit-card" hidden>
                            <h3>Editar tienda</h3>
                            <form id="edit-store-form" asp-action="UpdateStore" method="post" class="orbi-admin-edit-form">
                                <input id="edit-store-id" type="hidden" name="storeId" />
                                <div class="orbi-admin-form-grid">
                                    <div class="m3-text-field"><label class="m3-text-field-label" for="edit-store-name">Nombre</label><input class="m3-text-field-input" id="edit-store-name" name="name" required placeholder="Nombre de la tienda" /></div>
                                    <div class="m3-text-field"><label class="m3-text-field-label" for="edit-store-category">Categoría</label><input class="m3-text-field-input" id="edit-store-category" name="category" required placeholder="Ej: Restaurante" /></div>
                                    <div class="m3-text-field"><label class="m3-text-field-label" for="edit-store-address">Dirección</label><input class="m3-text-field-input" id="edit-store-address" name="address" required placeholder="Dirección completa" /></div>
                                    <div class="m3-text-field">
                                        <label class="m3-text-field-label" for="edit-store-owner-name">Nombre del propietario</label>
                                        <input class="m3-text-field-input" id="edit-store-owner-name" disabled value="Sin asignar" />
                                    </div>
                                    <div class="m3-text-field"><label class="m3-text-field-label" for="edit-store-owner-email">Correo</label><input class="m3-text-field-input" id="edit-store-owner-email" disabled value="No disponible" /></div>
                                    <div class="m3-text-field"><label class="m3-text-field-label" for="edit-store-owner-member-since">Miembro desde</label><input class="m3-text-field-input" id="edit-store-owner-member-since" disabled value="No disponible" /></div>
                                </div>
                                <div class="orbi-form-actions">
                                    <button class="m3-text-button" id="store-edit-cancel" type="button">Cancelar</button>
                                    <button class="m3-filled-button" type="submit">Guardar cambios</button>
                                </div>
                            </form>
                        </section>

                        <section class="m3-card orbi-admin-table-card">
                            <div class="orbi-admin-table-heading"><div><h3>Tiendas registradas</h3><p>Disponibilidad actual del catálogo local.</p></div></div>

                            <form asp-action="AdminStores" method="get" style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:flex-end;">
                                <div class="m3-text-field" style="margin:0;flex:1;min-width:180px;">
                                    <label class="m3-text-field-label">Buscar</label>
                                    <input type="search" name="buscar" value="@ViewBag.Buscar" class="m3-text-field-input" placeholder="Nombre, categoría..." style="height:40px;" />
                                </div>
                                <div class="m3-text-field" style="margin:0;min-width:160px;">
                                    <label class="m3-text-field-label">Provincia</label>
                                    <select name="provincia" class="m3-text-field-input" style="height:40px;" onchange="this.form.submit()">
                                        <option value="">Todas</option>
                                        @foreach (var p in (IEnumerable<EcuadorProvince>)ViewBag.Provincias)
                                        {
                                            <option value="@p.Code" selected="@(ViewBag.Provincia == p.Code)">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="m3-text-field" style="margin:0;min-width:160px;">
                                    <label class="m3-text-field-label">Ciudad</label>
                                    <select name="ciudad" class="m3-text-field-input" style="height:40px;" onchange="this.form.submit()">
                                        <option value="">Todas</option>
                                        @foreach (var c in (IEnumerable<EcuadorCity>)ViewBag.Ciudades)
                                        {
                                            <option value="@c.Code" selected="@(ViewBag.Ciudad == c.Code)">@c.Name</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="m3-filled-button" style="height:40px;padding:0 16px;">Buscar</button>
                                <a asp-action="AdminStores" class="m3-text-button" style="height:40px;line-height:40px;">Limpiar</a>
                            </form>
                            <div class="orbi-orders-table-wrap">
                                <table class="m3-data-table orbi-orders-table">
                                    <thead><tr><th>Tienda</th><th>Propietario</th><th>Categoría</th><th>Ciudad</th><th>Provincia</th><th>Estado</th><th>Acciones</th></tr></thead>
                                    <tbody>
                                    @foreach (var store in Model)
                                    {
                                        var owner = storeOwnerDetails.GetValueOrDefault(store.DeliveryStoreId);
                                        <tr>
                                            <td><strong>@store.Name</strong><small>#@store.DeliveryStoreId</small></td>
                                            <td>@storeOwners.GetValueOrDefault(store.DeliveryStoreId, "Sin asignar")</td>
                                            <td>@store.Category</td>
                                            <td>@(store.City?.Name ?? "-")</td><td>@(store.Province?.Name ?? "-")</td>
                                            <td><span class="orbi-order-status @(store.IsActive ? "is-delivered" : "is-cancelled")"><span class="orbi-status-dot"></span>@(store.IsActive ? "Activa" : "Inactiva")</span></td>
                                            <td><div class="orbi-admin-row-actions">
                                                <button type="button" class="m3-text-button" data-edit-store data-id="@store.DeliveryStoreId" data-name="@store.Name" data-category="@store.Category" data-address="@store.Address" data-owner-name="@(owner?.FullName ?? "Sin asignar")" data-owner-email="@(owner?.Email ?? "No disponible")" data-owner-member-since="@(owner is null || owner.MemberSince == default ? "No disponible" : owner.MemberSince.ToLocalTime().ToString("dd/MM/yyyy"))"><span class="material-symbols-outlined">edit</span>Editar</button>
                                                <form asp-action="ToggleStore" method="post" class="orbi-store-toggle-form"><input type="hidden" name="storeId" value="@store.DeliveryStoreId" /><label class="orbi-switch" title="@(store.IsActive ? "Inhabilitar tienda" : "Habilitar tienda")"><input type="checkbox" checked="@store.IsActive" role="switch" aria-label="@(store.IsActive ? "Inhabilitar tienda" : "Habilitar tienda")" onchange="this.form.requestSubmit()" /><span></span></label></form>
                                            </div></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <partial name="_Pagination" />
                        </section>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>

<script>
(function(){
    const section = document.getElementById('edit-store-section');
    const form = document.getElementById('edit-store-form');
    const ownerName = document.getElementById('edit-store-owner-name');
    const ownerEmail = document.getElementById('edit-store-owner-email');
    const ownerMemberSince = document.getElementById('edit-store-owner-member-since');

    document.querySelectorAll('[data-edit-store]').forEach(button => button.addEventListener('click', () => {
        document.getElementById('edit-store-id').value = button.dataset.id;
        document.getElementById('edit-store-name').value = button.dataset.name;
        document.getElementById('edit-store-category').value = button.dataset.category;
        document.getElementById('edit-store-address').value = button.dataset.address;
        ownerName.value = button.dataset.ownerName || 'Sin asignar';
        ownerEmail.value = button.dataset.ownerEmail || 'No disponible';
        ownerMemberSince.value = button.dataset.ownerMemberSince || 'No disponible';
        section.hidden = false;
        section.scrollIntoView({ behavior:'smooth', block:'start' });
        document.getElementById('edit-store-name').focus();
    }));
    document.getElementById('store-edit-cancel').addEventListener('click', () => {
        form.reset();
        section.hidden = true;
    });
})();
</script>
