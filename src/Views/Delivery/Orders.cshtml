@using SakilaApp.Models.Delivery
@model SakilaApp.Models.PaginatedList<DeliveryOrder>

@{
    var isDeliveryPerson = User.IsInRole("Repartidor");
    ViewData["Title"] = isDeliveryPerson ? "Mis entregas" : "Mis pedidos";
    ViewData["PaginatedList"] = Model;
    Func<string, string> statusClass = status => status switch
    {
        "Entregado" => "is-delivered",
        "En camino" => "is-transit",
        "En preparación" => "is-preparing",
        "Cancelado" => "is-cancelled",
        _ => "is-pending"
    };
}

<div class="m3-page orbi-orders-page">
    <header class="orbi-orders-header">
        <div><h1 class="m3-page-title">@ViewData["Title"]</h1><p>@(isDeliveryPerson ? "Pedidos asignados para entregar." : "Consulta el detalle y estado de tus compras.")</p></div>
    </header>

    <form asp-action="@(isDeliveryPerson ? "Deliveries" : "MyOrders")" method="get" class="orbi-order-search">
        <span class="material-symbols-outlined">search</span>
        <input type="search" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por pedido, tienda, producto o estado" aria-label="Buscar pedidos" />
        <button type="submit" class="m3-filled-button">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <a asp-action="@(isDeliveryPerson ? "Deliveries" : "MyOrders")" class="m3-text-button">Limpiar</a>
        }
    </form>

    @if (TempData["Success"] is string success)
    {
        <div class="orbi-alert">@success</div>
    }

    <section class="m3-card orbi-orders-table-card">
        @if (!Model.Any())
        {
            <div class="orbi-empty-state">No hay pedidos para mostrar.</div>
        }
        else
        {
            <div class="orbi-orders-table-wrap">
                <table class="m3-data-table orbi-orders-table">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Tienda y productos</th>
                            <th>Dirección</th>
                            <th>Total</th>
                            <th>Estado</th>
                            @if (isDeliveryPerson) { <th>Acciones</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.DeliveryOrderId</strong><small>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td><strong>@order.Store.Name</strong><small>@string.Join(" · ", order.Items.Select(item => $"{item.Quantity}× {item.ProductName}"))</small></td>
                                <td class="orbi-order-address">@order.DeliveryAddress</td>
                                <td><strong>$@order.Total.ToString("0.00")</strong></td>
                                <td><span class="orbi-order-status @statusClass(order.Status)"><span class="orbi-status-dot"></span>@order.Status</span></td>
                                @if (isDeliveryPerson)
                                {
                                    <td>
                                        @if (order.Status != "Entregado")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="orbi-delivery-actions">
                                                <input type="hidden" name="orderId" value="@order.DeliveryOrderId" />
                                                <button class="m3-text-button" name="status" value="En camino">En camino</button>
                                                <button class="m3-text-button" name="status" value="Entregado">Entregado</button>
                                            </form>
                                        }
                                        else { <span>—</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="_Pagination" />
    </section>
</div>
