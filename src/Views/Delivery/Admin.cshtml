@using SakilaApp.Models.Delivery
@model AdminDashboardViewModel
@{ ViewData["Title"] = "Administración"; }

<div class="orbi-account-shell orbi-delivery-admin-shell">
    <header class="orbi-account-shell-header">
        <h1>Administración</h1>
        <p>Gestiona tiendas y pedidos de Orbi.</p>
    </header>

    <div class="orbi-account-layout">
        <aside><partial name="_AdminNav" /></aside>

        <main class="orbi-account-main">
            @if (TempData["Success"] is string success)
            {
                <div class="orbi-alert">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="orbi-alert orbi-alert-error">@error</div>
            }

            <section id="stores" class="orbi-account-section">
                <header class="orbi-account-section-header">
                    <div>
                        <span class="material-symbols-outlined orbi-section-icon">storefront</span>
                        <h2>Tiendas</h2>
                    </div>
                    <p>Edita la información y controla su disponibilidad.</p>
                </header>
                <div class="orbi-account-section-content">
                    <div class="orbi-admin-grid">
                        <section id="edit-store-section" class="m3-card orbi-admin-edit-card">
                            <h3>Editar tienda</h3>
                            <form asp-action="UpdateStore" method="post" class="orbi-admin-edit-form">
                                <input id="edit-store-id" type="hidden" name="storeId" />
                                <div class="m3-text-field">
                                    <label class="m3-text-field-label" for="edit-store-name">Nombre</label>
                                    <input class="m3-text-field-input" id="edit-store-name" name="name" required placeholder="Selecciona Editar en la tabla" />
                                </div>
                                <div class="m3-text-field">
                                    <label class="m3-text-field-label" for="edit-store-category">Categoría</label>
                                    <input class="m3-text-field-input" id="edit-store-category" name="category" required />
                                </div>
                                <div class="m3-text-field">
                                    <label class="m3-text-field-label" for="edit-store-address">Dirección</label>
                                    <input class="m3-text-field-input" id="edit-store-address" name="address" required />
                                </div>
                                <div class="orbi-form-actions">
                                    <button class="m3-filled-button" type="submit">Guardar cambios</button>
                                </div>
                            </form>
                        </section>

                        <section class="m3-card orbi-admin-table-card">
                            <div class="orbi-admin-table-heading">
                                <div>
                                    <h3>Tiendas registradas</h3>
                                    <p>Disponibilidad actual del catálogo local.</p>
                                </div>
                            </div>
                            <div class="orbi-orders-table-wrap">
                                <table class="m3-data-table orbi-orders-table">
                                    <thead>
                                        <tr>
                                            <th>Tienda</th>
                                            <th>Categoría</th>
                                            <th>Dirección</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var store in Model.Stores)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@store.Name</strong>
                                                <small>#@store.DeliveryStoreId</small>
                                            </td>
                                            <td>@store.Category</td>
                                            <td class="orbi-order-address">@store.Address</td>
                                            <td>
                                                <span class="orbi-order-status @(store.IsActive ? "is-delivered" : "is-cancelled")">
                                                    <span class="orbi-status-dot"></span>
                                                    @(store.IsActive ? "Activa" : "Inactiva")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="orbi-admin-row-actions">
                                                    <button type="button" class="m3-text-button" data-edit-store
                                                        data-id="@store.DeliveryStoreId"
                                                        data-name="@store.Name"
                                                        data-category="@store.Category"
                                                        data-address="@store.Address">
                                                        <span class="material-symbols-outlined">edit</span>Editar
                                                    </button>
                                                    <form asp-action="ToggleStore" method="post" class="orbi-store-toggle-form">
                                                        <input type="hidden" name="storeId" value="@store.DeliveryStoreId" />
                                                        <label class="orbi-switch" title="@(store.IsActive ? "Inhabilitar tienda" : "Habilitar tienda")">
                                                            <input type="checkbox" checked="@store.IsActive" role="switch"
                                                                aria-label="@(store.IsActive ? "Inhabilitar tienda" : "Habilitar tienda")"
                                                                onchange="this.form.requestSubmit()" />
                                                            <span></span>
                                                        </label>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            @await Html.PartialAsync("_Pagination", Model.Stores)
                        </section>
                    </div>
                </div>
            </section>

            <section id="orders" class="orbi-account-section">
                <header class="orbi-account-section-header">
                    <div>
                        <span class="material-symbols-outlined orbi-section-icon">receipt_long</span>
                        <h2>Pedidos</h2>
                    </div>
                    <p>Consulta y actualiza el estado de las entregas.</p>
                </header>
                <div class="orbi-account-section-content">
                    <div class="orbi-admin-grid">
                        <section id="edit-order-section" class="m3-card orbi-admin-edit-card">
                            <h3>Actualizar pedido</h3>
                            <form asp-action="UpdateStatus" method="post" class="orbi-admin-edit-form">
                                <div class="m3-text-field">
                                    <label class="m3-text-field-label" for="edit-order-id">Pedido</label>
                                    <select class="m3-text-field-input" id="edit-order-id" name="orderId" required>
                                        <option value="">Selecciona un pedido</option>
                                        @foreach (var order in Model.Orders)
                                        {
                                            <option value="@order.DeliveryOrderId">#@order.DeliveryOrderId - @order.Store.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="m3-text-field">
                                    <label class="m3-text-field-label" for="edit-order-status">Nuevo estado</label>
                                    <select class="m3-text-field-input" id="edit-order-status" name="status" required>
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="En preparación">En preparación</option>
                                        <option value="En camino">En camino</option>
                                        <option value="Entregado">Entregado</option>
                                        <option value="Cancelado">Cancelado</option>
                                    </select>
                                </div>
                                <div class="orbi-form-actions">
                                    <button class="m3-filled-button" type="submit">Actualizar estado</button>
                                </div>
                            </form>
                        </section>

                        <section class="m3-card orbi-admin-table-card">
                            <div class="orbi-admin-table-heading">
                                <div>
                                    <h3>Pedidos registrados</h3>
                                    <p>Estado general de clientes y entregas.</p>
                                </div>
                            </div>
                            <div class="orbi-orders-table-wrap">
                                <table class="m3-data-table orbi-orders-table">
                                    <thead>
                                        <tr>
                                            <th>Pedido</th>
                                            <th>Tienda y productos</th>
                                            <th>Cliente</th>
                                            <th>Repartidor</th>
                                            <th>Total</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@order.DeliveryOrderId</strong>
                                                <small>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong>@order.Store.Name</strong>
                                                <small>@string.Join(" · ", order.Items.Select(item => $"{item.Quantity}× {item.ProductName}"))</small>
                                            </td>
                                            <td>@order.CustomerEmail</td>
                                            <td>@order.DeliveryPersonEmail</td>
                                            <td><strong>$@order.Total.ToString("0.00")</strong></td>
                                            <td>
                                                <span class="orbi-order-status @(order.Status == "Entregado" ? "is-delivered" : order.Status == "En camino" ? "is-transit" : order.Status == "En preparación" ? "is-preparing" : order.Status == "Cancelado" ? "is-cancelled" : "is-pending")">
                                                    <span class="orbi-status-dot"></span>@order.Status
                                                </span>
                                            </td>
                                            <td>
                                                <button type="button" class="m3-text-button" data-edit-order
                                                    data-id="@order.DeliveryOrderId"
                                                    data-status="@order.Status">
                                                    <span class="material-symbols-outlined">edit</span>Editar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            @await Html.PartialAsync("_Pagination", Model.Orders)
                        </section>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>

<script>
document.querySelectorAll('[data-edit-store]').forEach(button => button.addEventListener('click', () => {
    document.getElementById('edit-store-id').value = button.dataset.id;
    document.getElementById('edit-store-name').value = button.dataset.name;
    document.getElementById('edit-store-category').value = button.dataset.category;
    document.getElementById('edit-store-address').value = button.dataset.address;
    document.getElementById('edit-store-section').scrollIntoView({ behavior:'smooth', block:'start' });
    document.getElementById('edit-store-name').focus();
}));

document.querySelectorAll('[data-edit-order]').forEach(button => button.addEventListener('click', () => {
    document.getElementById('edit-order-id').value = button.dataset.id;
    document.getElementById('edit-order-status').value = button.dataset.status;
    document.getElementById('edit-order-section').scrollIntoView({ behavior:'smooth', block:'start' });
    document.getElementById('edit-order-status').focus();
}));
</script>
