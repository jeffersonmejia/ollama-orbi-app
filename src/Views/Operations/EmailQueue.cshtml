@model SakilaApp.Models.PaginatedList<SakilaApp.Models.Operations.EmailQueueItem>
@{
    ViewData["Title"] = "Cola de correos";
    var defaultSchedule = DateTimeOffset.UtcNow.ToString("yyyy-MM-ddTHH:mm");
}

<div class="orbi-operations-page">
    <header class="orbi-operations-header"><div><h1>Cola de correos</h1><p>Programa mensajes y administra envíos pendientes o fallidos.</p></div></header>
    <partial name="_OperationsNav" /><partial name="_Alerts" />
    <section class="m3-card orbi-operation-section"><h2>Agregar correo</h2>
        <form class="orbi-operation-form" asp-action="EnqueueEmail" method="post">
            <div class="m3-text-field"><label class="m3-text-field-label" for="recipientEmail">Destinatario</label><input class="m3-text-field-input" id="recipientEmail" name="recipientEmail" type="email" required /></div>
            <div class="m3-text-field"><label class="m3-text-field-label" for="scheduledAt">Programado para</label><input class="m3-text-field-input" id="scheduledAt" name="scheduledAt" type="datetime-local" value="@defaultSchedule" /></div>
            <div class="m3-text-field orbi-field-full"><label class="m3-text-field-label" for="subject">Asunto</label><input class="m3-text-field-input" id="subject" name="subject" maxlength="255" required /></div>
            <div class="m3-text-field orbi-field-full"><label class="m3-text-field-label" for="bodyHtml">Contenido HTML</label><textarea class="m3-text-field-input" id="bodyHtml" name="bodyHtml" rows="5" style="height:auto;padding-top:12px;" required></textarea></div>
            <div class="orbi-form-actions"><button class="m3-filled-button" type="submit">Agregar a la cola</button></div>
        </form>
    </section>
    <section class="m3-card orbi-operation-section"><h2>Mensajes recientes</h2>
        @if(!Model.Any()){<div class="orbi-empty-state">La cola está vacía.</div>}
        else {<div class="orbi-operation-table-wrap"><table class="m3-data-table"><thead><tr><th>Creado</th><th>Destinatario</th><th>Asunto</th><th>Estado</th><th>Intentos</th><th>Programado</th><th>Error</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.RecipientEmail</td><td>@item.Subject</td><td><span class="orbi-status">@item.Status</span></td><td>@item.AttemptCount / @item.MaxAttempts</td><td>@item.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(item.LastError ?? "—")</td><td><div style="display:flex;gap:4px;">@if(item.Status == "Fallido"){<form asp-action="RetryEmail" method="post"><input type="hidden" name="id" value="@item.EmailQueueId"/><button class="m3-text-button" type="submit">Reintentar</button></form>}@if(item.Status != "Enviado" && item.Status != "Cancelado"){<form asp-action="CancelEmail" method="post"><input type="hidden" name="id" value="@item.EmailQueueId"/><button class="m3-text-button" type="submit">Cancelar</button></form>}</div></td></tr>}</tbody></table></div>}
        <partial name="_TableSummaryPagination" model="Model" />
    </section>
</div>
