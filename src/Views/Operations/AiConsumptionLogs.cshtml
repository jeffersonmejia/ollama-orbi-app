@model SakilaApp.Models.PaginatedList<SakilaApp.Models.Operations.AiConsumptionLog>
@{ ViewData["Title"] = "Consumo de IA"; }

<div class="orbi-operations-page">
    <header class="orbi-operations-header"><div><h1>Consumo de inteligencia artificial</h1><p>Registro de cada prompt enviado por los usuarios, con quién, qué preguntó y desde dónde.</p></div></header>
    <partial name="_OperationsNav" />
    <section class="m3-card orbi-operation-section">
        <h2>Filtrar</h2>
        <form asp-action="AiConsumptionLogs" method="get" class="orbi-operation-form orbi-filter-form">
            <div class="m3-text-field orbi-field-full">
                <label class="m3-text-field-label" for="buscar">Usuario, modelo o prompt</label>
                <input class="m3-text-field-input" id="buscar" name="buscar" value="@ViewBag.Buscar" />
            </div>
            <div class="orbi-form-actions">
                <a asp-action="AiConsumptionLogs" class="m3-text-button">Limpiar</a>
                <button class="m3-filled-button" type="submit">Buscar</button>
            </div>
        </form>
    </section>
    <section class="m3-card orbi-operation-section">
        <h2>Registros</h2>
        @if (!Model.Any())
        {
            <div class="orbi-empty-state">Todavía no hay consumo de IA registrado.</div>
        }
        else
        {
            <div class="orbi-operation-table-wrap">
                <table class="m3-data-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Prompt</th>
                            <th>Modelo</th>
                            <th>Tokens</th>
                            <th>Duración</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(item.User?.Email ?? "Anónimo")</td>
                                <td class="orbi-json-preview" title="@item.PromptText">@item.PromptText</td>
                                <td>@item.ModelName</td>
                                <td>@item.TotalTokens</td>
                                <td>@item.DurationMilliseconds ms</td>
                                <td>@(item.IpAddress ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="_TableSummaryPagination" model="Model" />
    </section>
</div>
