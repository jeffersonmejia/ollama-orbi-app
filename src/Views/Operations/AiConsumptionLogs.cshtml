@model IReadOnlyList<SakilaApp.Models.Operations.AiConsumptionLog>
@{ ViewData["Title"] = "Consumo de IA"; }

<div class="orbi-operations-page">
    <header class="orbi-operations-header"><div><h1>Consumo de inteligencia artificial</h1><p>Métricas técnicas de solicitudes, tokens, costo estimado y duración.</p></div></header>
    <partial name="_OperationsNav" />
    <section class="m3-card orbi-operation-section">
        @if(!Model.Any()){<div class="orbi-empty-state">Todavía no hay consumo de IA registrado.</div>}
        else {<div class="orbi-operation-table-wrap"><table class="m3-data-table"><thead><tr><th>Fecha</th><th>Usuario</th><th>Modelo</th><th>Operación</th><th>Entrada</th><th>Salida</th><th>Total</th><th>Costo</th><th>Duración</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(item.User?.Email ?? "Anónimo")</td><td>@item.ModelName</td><td>@item.Operation</td><td>@item.PromptTokens</td><td>@item.CompletionTokens</td><td>@item.TotalTokens</td><td>$@item.EstimatedCost.ToString("0.000000")</td><td>@item.DurationMilliseconds ms</td></tr>}</tbody></table></div>}
    </section>
</div>
