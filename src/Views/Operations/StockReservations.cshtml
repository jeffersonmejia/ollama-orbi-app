@model SakilaApp.Models.Operations.StockReservationsViewModel
@{
    ViewData["Title"] = "Reservas de stock";
    var defaultExpiration = DateTimeOffset.UtcNow.AddMinutes(30).ToString("yyyy-MM-ddTHH:mm");
}

<div class="orbi-operations-page">
    <header class="orbi-operations-header"><div><h1>Reservas de stock</h1><p>Bloquea temporalmente cantidades para pedidos en proceso.</p></div></header>
    <partial name="_OperationsNav" /><partial name="_Alerts" />
    <section class="m3-card orbi-operation-section"><h2>Nueva reserva</h2>
        <form class="orbi-operation-form" asp-action="CreateStockReservation" method="post">
            <div class="m3-text-field"><label class="m3-text-field-label" for="deliveryProductId">Producto</label><select class="m3-text-field-input" id="deliveryProductId" name="deliveryProductId" required><option value="">Selecciona</option>@foreach(var item in Model.Products){<option value="@item.DeliveryProductId">@item.Store.Name · @item.Name</option>}</select></div>
            <div class="m3-text-field"><label class="m3-text-field-label" for="deliveryOrderId">Pedido</label><select class="m3-text-field-input" id="deliveryOrderId" name="deliveryOrderId" required><option value="">Selecciona</option>@foreach(var order in Model.Orders){<option value="@order.DeliveryOrderId">#@order.DeliveryOrderId · @order.CustomerEmail</option>}</select></div>
            <div class="m3-text-field"><label class="m3-text-field-label" for="quantity">Cantidad</label><input class="m3-text-field-input" id="quantity" name="quantity" type="number" min="1" required /></div>
            <div class="m3-text-field"><label class="m3-text-field-label" for="expiresAt">Vence</label><input class="m3-text-field-input" id="expiresAt" name="expiresAt" type="datetime-local" value="@defaultExpiration" required /></div>
            <div class="orbi-form-actions"><button class="m3-filled-button" type="submit">Crear reserva</button></div>
        </form>
    </section>
    <section class="m3-card orbi-operation-section"><h2>Reservas recientes</h2>
        @if(!Model.Reservations.Any()){<div class="orbi-empty-state">No hay reservas registradas.</div>}
        else {<div class="orbi-operation-table-wrap"><table class="m3-data-table"><thead><tr><th>Producto</th><th>Pedido</th><th>Cantidad</th><th>Estado</th><th>Vence</th><th>Responsable</th><th>Acción</th></tr></thead><tbody>@foreach(var item in Model.Reservations){<tr><td>@item.Product.Store.Name · @item.Product.Name</td><td>#@item.DeliveryOrderId</td><td>@item.Quantity</td><td><span class="orbi-status">@item.Status</span></td><td>@item.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(item.ReservedByUser?.Email ?? "Sistema")</td><td>@if(item.Status == "Activa"){<form asp-action="ReleaseStockReservation" method="post"><input type="hidden" name="id" value="@item.StockReservationId"/><button class="m3-text-button" type="submit">Liberar</button></form>}else{<span>—</span>}</td></tr>}</tbody></table></div>}
    </section>
</div>
