<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Orbi App</title>
    <link rel="stylesheet" href="~/css/m3/m3-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/m3/m3-animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delivery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile-addresses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="~/SakilaApp.styles.css" asp-append-version="true" />
</head>
<body>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var currentUserRole = string.Empty;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null)
        {
            currentUserRole = (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault() ?? "Sin rol";
        }
    }
}
<div class="m3-app-layout orbi-chat-layout">
    <nav class="m3-nav-rail">
        <div class="m3-nav-rail-header"></div>

        <ul class="m3-nav-items">
            <li>
                <a class="m3-nav-item @(currentController == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span>Inicio</span>
                </a>
            </li>

            <li>
                <button id="orbi-chat-nav-toggle" class="m3-nav-item orbi-chat-nav-toggle" type="button" aria-expanded="false" aria-controls="orbi-chat-panel">
                    <span class="material-symbols-outlined">smart_toy</span>
                    <span>Asistente</span>
                </button>
            </li>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <li>
                    <a class="m3-nav-item @(currentController == "Delivery" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Delivery" asp-action="Index">
                        <span class="material-symbols-outlined">storefront</span>
                        <span>Tiendas</span>
                    </a>
                </li>
                @if (User.IsInRole("Usuario"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="MyOrders"><span class="material-symbols-outlined">receipt_long</span><span>Pedidos</span></a></li>
                }
                @if (User.IsInRole("Repartidor"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="Deliveries"><span class="material-symbols-outlined">delivery_dining</span><span>Entregas</span></a></li>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <li><a class="m3-nav-item" asp-controller="Delivery" asp-action="Admin"><span class="material-symbols-outlined">admin_panel_settings</span><span>Admin</span></a></li>
                }
                <li>
                    <a class="m3-nav-item orbi-operation-nav-item @(currentController == "Operations" ? "active" : "")"
                       asp-controller="@(User.IsInRole("Vendedor") ? "Delivery" : "Operations")" asp-action="@(User.IsInRole("Vendedor") ? "SellerInventory" : User.IsInRole("Administrador") ? "DeliveryIncidents" : "Index")">
                        <span class="material-symbols-outlined">monitoring</span>
                        <span>@(User.IsInRole("Administrador") ? "Operación" : User.IsInRole("Vendedor") ? "Inventario" : "Seguimiento")</span>
                    </a>
                </li>
            }

            @* Módulos Sakila conservados en el proyecto base, ocultos en la navegación de Orbi.
            @if (User.IsInRole("Administrador"))
            {
                <li><div class="m3-nav-divider"></div></li>
                <li>
                    <a class="m3-nav-item @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "PanelAdministrador" ? "active" : "")"
                       asp-area="" asp-controller="Home" asp-action="PanelAdministrador">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/>
                            <rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/>
                        </svg>
                        <span>Admin</span>
                    </a>
                </li>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><div class="m3-nav-divider"></div></li>
                <li>
                    <a class="m3-nav-item @(currentController == "Actor" ? "active" : "")"
                       asp-area="" asp-controller="Actor" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>Actor</span>
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a class="m3-nav-item @(currentController == "Address" ? "active" : "")"
                           asp-area="" asp-controller="Address" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            <span>Address</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor") || User.IsInRole("Consulta"))
                {
                    <li>
                        <a class="m3-nav-item @(currentController == "Category" ? "active" : "")"
                           asp-area="" asp-controller="Category" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h6v6H4z"/>
                                <path d="M14 4h6v6h-6z"/>
                                <path d="M4 14h6v6H4z"/>
                                <path d="M14 14h6v6h-6z"/>
                            </svg>
                            <span>Category</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a class="m3-nav-item @(currentController == "City" ? "active" : "")"
                           asp-area="" asp-controller="City" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                                <line x1="9" y1="6" x2="9" y2="6.01"/>
                                <line x1="15" y1="6" x2="15" y2="6.01"/>
                                <line x1="9" y1="10" x2="9" y2="10.01"/>
                                <line x1="15" y1="10" x2="15" y2="10.01"/>
                            </svg>
                            <span>City</span>
                        </a>
                    </li>
                }
                <li>
                    <a class="m3-nav-item @(currentController == "Films" ? "active" : "")"
                       asp-area="" asp-controller="Films" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                            <line x1="7" y1="2" x2="7" y2="22"/>
                            <line x1="17" y1="2" x2="17" y2="22"/>
                            <line x1="2" y1="12" x2="22" y2="12"/>
                            <line x1="2" y1="7" x2="7" y2="7"/>
                            <line x1="2" y1="17" x2="7" y2="17"/>
                            <line x1="17" y1="7" x2="22" y2="7"/>
                            <line x1="17" y1="17" x2="22" y2="17"/>
                        </svg>
                        <span>Films</span>
                    </a>
                </li>
                <li>
                    <a class="m3-nav-item @(currentController == "Store" ? "active" : "")"
                       asp-area="" asp-controller="Store" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                        <span>Tienda</span>
                    </a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a class="m3-nav-item @(currentController == "Inventory" ? "active" : "")"
                           asp-area="" asp-controller="Inventory" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="2" y1="10" x2="22" y2="10"/>
                                <path d="M8 21h8"/>
                                <path d="M12 17v4"/>
                            </svg>
                            <span>Inventario</span>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a class="m3-nav-item @(currentController == "Language" ? "active" : "")"
                           asp-area="" asp-controller="Language" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                            <span>Language</span>
                        </a>
                    </li>
                }
            }
            *@
        </ul>

        <div class="m3-nav-rail-footer">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="m3-nav-item orbi-profile-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index"
                   title="@UserManager.GetUserName(User)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span class="orbi-profile-label">
                        <span>Perfil</span>
                        <small>@currentUserRole</small>
                    </span>
                </a>
            }
            else
            {
                <a class="m3-nav-item" asp-area="Identity" asp-page="/Account/Login">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Ingresar</span>
                </a>
                <a class="m3-nav-item" asp-area="Identity" asp-page="/Account/Register">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="8.5" cy="7" r="4"/>
                        <line x1="20" y1="8" x2="20" y2="14"/>
                        <line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                    <span>Registro</span>
                </a>
            }
        </div>
    </nav>

    <div class="m3-content-area">
        <header class="m3-top-app-bar">
            <h1 class="m3-top-app-bar-title @(currentController == "Home" ? "orbi-top-brand" : "")">
                @if (currentController == "Home")
                {
                    <span class="orbi-top-brand-mark" aria-hidden="true">
                        <span class="material-symbols-outlined">shopping_bag</span>
                    </span>
                }
                <span>@ViewData["Title"]</span>
            </h1>
        </header>

        <main class="m3-main @(currentController == "Home" && User.Identity?.IsAuthenticated != true ? "orbi-public-home-main" : string.Empty)">
            @RenderBody()
        </main>

        <footer class="m3-footer">
            &copy; 2026 Orbi App. Todos los derechos reservados.
        </footer>
    </div>
</div>

<partial name="_ContextualChat" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/m3.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
