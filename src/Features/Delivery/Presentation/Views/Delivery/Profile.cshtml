@model List<OrbiApp.Models.Identity.UserAddress>
@{
    OrbiApp.Models.Identity.UserProfile profile = ViewBag.Profile;
    List<OrbiApp.Models.Identity.EcuadorProvince> provinces = ViewBag.Provinces;
    List<OrbiApp.Models.Identity.EcuadorCity> cities = ViewBag.Cities;
    var success = TempData["Success"] as string;
}

<div class="m3-page">
    <h1 class="m3-page-title"><span class="material-symbols-outlined" style="font-size:32px;vertical-align:middle;margin-right:8px;">person</span>Mi Perfil</h1>

    @if (!string.IsNullOrEmpty(success))
    {
        <div style="padding:12px 16px;border-radius:12px;background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);margin-bottom:1rem;font-size:var(--md-sys-typescale-body-medium-size);">@success</div>
    }

    <!-- Profile form -->
    <div class="m3-card" style="padding:24px;margin-bottom:1.5rem;">
        <h2 style="font-size:var(--md-sys-typescale-title-medium-size);font-weight:var(--md-sys-typescale-title-medium-weight);color:var(--md-sys-color-on-surface);margin:0 0 16px;">Datos personales</h2>
        <form asp-action="UpdateProfile" method="post" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            @Html.AntiForgeryToken()
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Nombre</label>
                <input name="firstName" value="@profile?.FirstName" required class="m3-input" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Apellido</label>
                <input name="lastName" value="@profile?.LastName" required class="m3-input" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Cédula</label>
                <input name="cedula" value="@profile?.Cedula" required class="m3-input" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Dirección línea 1</label>
                <input name="addressLine1" value="@profile?.AddressLine1" required class="m3-input" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Dirección línea 2</label>
                <input name="addressLine2" value="@profile?.AddressLine2" class="m3-input" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Provincia</label>
                <select name="provinceCode" required class="m3-input">
                    @foreach (var p in provinces)
                    {
                        <option value="@p.Code" selected="@(p.Code == profile?.ProvinceCode)">@p.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Ciudad</label>
                <select name="cityCode" required class="m3-input">
                    @foreach (var c in cities.Where(c => c.ProvinceCode == profile?.ProvinceCode))
                    {
                        <option value="@c.Code" selected="@(c.Code == profile?.CityCode)">@c.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                <label style="font-size:var(--md-sys-typescale-label-small-size);color:var(--md-sys-color-on-surface-variant);">Referencia</label>
                <input name="reference" value="@profile?.Reference" class="m3-input" />
            </div>
            <div style="grid-column:1/-1;margin-top:8px;">
                <button type="submit" class="m3-filled-button">
                    <span class="material-symbols-outlined" style="font-size:18px;">save</span> Guardar cambios
                </button>
            </div>
        </form>
    </div>

    <section class="m3-card" style="padding:24px;margin-bottom:1.5rem;">
        <h2 style="font-size:var(--md-sys-typescale-title-medium-size);font-weight:var(--md-sys-typescale-title-medium-weight);color:var(--md-sys-color-on-surface);margin:0 0 8px;">Mi dirección</h2>
        <p style="color:var(--md-sys-color-on-surface-variant);margin:0 0 16px;">Tu cuenta tiene una sola dirección. Al cambiarla aquí, se actualiza también la ubicación de tu tienda si corresponde.</p>
        @if (Model.FirstOrDefault() is { } address)
        {
            <div style="padding:16px;border-radius:12px;background:var(--md-sys-color-surface-container-low);color:var(--md-sys-color-on-surface);">
                <strong>@address.Label · Única dirección</strong>
                <p style="margin:6px 0 0;color:var(--md-sys-color-on-surface-variant);">@address.FormattedAddress</p>
            </div>
        }
        else
        {
            <p style="color:var(--md-sys-color-on-surface-variant);">Aún no tienes una dirección registrada. Completa los campos de ubicación en tus datos personales.</p>
        }
        <a class="m3-text-button" href="/Identity/Account/Manage/Addresses" style="margin-top:12px;">Editar dirección</a>
    </section>

    <div style="margin-top:1rem;">
        <a class="m3-text-button" asp-action="Cart">
            <span class="material-symbols-outlined" style="font-size:18px;margin-right:4px;">arrow_back</span>
            Volver al carrito
        </a>
    </div>
</div>

<script>
document.querySelectorAll('select[name="provinceCode"]').forEach(sel => {
    sel.addEventListener('change', function() {
        const form = this.closest('form');
        const citySelect = form.querySelector('select[name="cityCode"]');
        if (!citySelect) return;
        const provinceCode = this.value;
        const cities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cities.Select(c => new { c.Code, c.ProvinceCode, c.Name })));
        citySelect.innerHTML = '<option value="">Seleccionar ciudad</option>';
        cities.filter(c => c.ProvinceCode === provinceCode).forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.Code;
            opt.textContent = c.Name;
            citySelect.appendChild(opt);
        });
    });
});
</script>
