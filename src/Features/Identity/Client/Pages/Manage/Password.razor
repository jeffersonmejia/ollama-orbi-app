@page "/Identity/Account/Manage/ChangePassword"
@page "/Identity/Account/Manage/SetPassword"
@namespace OrbiApp.Presentation.Client.Pages.Identity.Manage
@attribute [Authorize]
@using System.Text.Json
@using OrbiApp.Features.Identity.Client.Contracts
@inject HttpClient Api
@inject NavigationManager Navigation

<PageTitle>@(_isSetMode ? "Configurar clave" : "Cambiar contraseña") - Dash</PageTitle>

<div class="orbi-account-shell">
    <AccountManageNavigation />
    <div class="@(_isSetMode ? "m3-form-container" : "orbi-account-page")">
        @if (_loading)
        {
            <p class="m3-supporting-text" role="status">Cargando…</p>
        }
        else if (!_ready)
        {
            <section class="orbi-route-error" role="alert">
                <p>@_error</p>
                <button type="button" class="m3-text-button" @onclick="LoadAsync">Reintentar</button>
            </section>
        }
        else
        {
            <section class="@(_isSetMode ? string.Empty : "orbi-google-card")">
                @if (_isSetMode)
                {
                    <h3>Configurar clave</h3>
                    <p class="m3-supporting-text">Tu cuenta todavía no tiene una clave. Configúrala para poder iniciar sesión también con tu correo.</p>
                }
                else
                {
                <div class="orbi-google-card-heading">
                    <div>
                        <h2>Cambiar contraseña</h2>
                        <p>Actualiza la contraseña de acceso a tu cuenta.</p>
                    </div>
                    <span class="material-symbols-outlined" aria-hidden="true">password</span>
                </div>
                }
                @if (_message is not null) { <p class="m3-supporting-text" role="status">@_message</p> }
                @if (_error is not null) { <p class="m3-validation-error" role="alert">@_error</p> }
                <EditForm Model="_input" OnValidSubmit="SaveAsync" class="@(_isSetMode ? string.Empty : "orbi-account-rows")" @key="_input">
                    <DataAnnotationsValidator />
                    @if (!_isSetMode)
                    {
                        <div class="orbi-account-row orbi-account-row-editable">
                            <label for="account-current-password">Contraseña actual</label>
                            <InputText id="account-current-password" @bind-Value="ChangeInput.OldPassword" type="password" autocomplete="current-password" aria-required="true" placeholder="Ingresa tu contraseña actual" disabled="@_busy" />
                        </div>
                        <ValidationMessage For="() => ChangeInput.OldPassword" class="m3-validation-error" />
                    }
                    @if (_isSetMode)
                    {
                        <div class="m3-text-field">
                            <InputText id="account-new-password" @bind-Value="_input.NewPassword" type="password" class="m3-text-field-input" autocomplete="new-password" placeholder="Escribe la nueva clave." disabled="@_busy" />
                            <label for="account-new-password" class="m3-text-field-label">Nueva clave</label>
                            <ValidationMessage For="() => _input.NewPassword" class="m3-validation-error" />
                        </div>
                        <div class="m3-text-field">
                            <InputText id="account-confirm-password" @bind-Value="_input.ConfirmPassword" type="password" class="m3-text-field-input" autocomplete="new-password" placeholder="Confirma la nueva clave." disabled="@_busy" />
                            <label for="account-confirm-password" class="m3-text-field-label">Confirmar clave</label>
                            <ValidationMessage For="() => _input.ConfirmPassword" class="m3-validation-error" />
                        </div>
                    }
                    else
                    {
                    <div class="orbi-account-row orbi-account-row-editable">
                        <label for="account-new-password">Nueva contraseña</label>
                        <InputText id="account-new-password" @bind-Value="_input.NewPassword" type="password" autocomplete="new-password" aria-required="true" placeholder="Ingresa tu nueva contraseña" disabled="@_busy" />
                    </div>
                    <ValidationMessage For="() => _input.NewPassword" class="m3-validation-error" />
                    <div class="orbi-account-row orbi-account-row-editable">
                        <label for="account-confirm-password">Confirmar contraseña</label>
                        <InputText id="account-confirm-password" @bind-Value="_input.ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" placeholder="Confirma tu nueva contraseña" disabled="@_busy" />
                    </div>
                    <ValidationMessage For="() => _input.ConfirmPassword" class="m3-validation-error" />
                    }
                    <div><button type="submit" class="m3-filled-button" disabled="@_busy">@(_busy ? "Guardando…" : _isSetMode ? "Guardar clave" : "Actualizar contraseña")</button></div>
                </EditForm>
            </section>
        }
    </div>
</div>

@code {
    private SetIdentityPasswordRequest _input = new ChangeIdentityPasswordRequest();
    private ChangeIdentityPasswordRequest ChangeInput => (ChangeIdentityPasswordRequest)_input;
    private bool _loading = true, _ready, _busy, _isSetMode;
    private bool _loadPending;
    private bool? _currentMode;
    private string? _error, _message;

    protected override void OnParametersSet()
    {
        var isSetMode = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').EndsWith("/SetPassword", StringComparison.OrdinalIgnoreCase);
        if (_currentMode == isSetMode) return;
        _currentMode = _isSetMode = isSetMode;
        _input = _isSetMode ? new SetIdentityPasswordRequest() : new ChangeIdentityPasswordRequest();
        _loading = true; _ready = false; _loadPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadPending) return;
        _loadPending = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _ready = false; _error = null;
        try
        {
            var status = await Api.GetFromJsonAsync<IdentityPasswordStatusResponse>("/api/identity/account/password") ?? throw new JsonException();
            if (status.HasPassword == _isSetMode)
                Navigation.NavigateTo(status.HasPassword ? "/Identity/Account/Manage/ChangePassword" : "/Identity/Account/Manage/SetPassword", replace: true);
            _ready = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        { _error = "No se pudo cargar la configuración de contraseña. Inténtalo de nuevo."; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try
        {
            var token = (await Api.GetFromJsonAsync<AntiforgeryResponse>("/api/security/antiforgery"))?.RequestToken;
            if (string.IsNullOrWhiteSpace(token)) throw new InvalidOperationException();
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/api/identity/account/password/{(_isSetMode ? "set" : "change")}");
            request.Content = _isSetMode ? JsonContent.Create(_input) : JsonContent.Create(ChangeInput);
            request.Headers.Add("RequestVerificationToken", token);
            using var response = await Api.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == HttpStatusCode.Unauthorized)
                    _error = "Tu sesión ya no está activa. Inicia sesión nuevamente.";
                else
                {
                    var error = await response.Content.ReadFromJsonAsync<IdentityPasswordActionResponse>();
                    _error = error?.Errors is { Count: > 0 } ? string.Join(" ", error.Errors) : error?.Message ?? "No se pudo guardar la contraseña.";
                }
                return;
            }
            _message = (await response.Content.ReadFromJsonAsync<IdentityPasswordActionResponse>())?.Message ?? "Contraseña guardada.";
            if (_isSetMode)
                Navigation.NavigateTo("/Identity/Account/Manage/ChangePassword", replace: true);
            else
                _input = new ChangeIdentityPasswordRequest();
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or InvalidOperationException or TaskCanceledException)
        { _error = "No se pudo completar la solicitud. Inténtalo de nuevo."; }
        finally { _busy = false; }
    }

    private sealed record AntiforgeryResponse(string RequestToken);
}
