@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="orbi-account-page">
    <header class="orbi-account-identity">
        <div class="orbi-account-avatar">@((Model.Username ?? "U")[..1].ToUpperInvariant())</div>
        <h1>@Model.Username</h1>
        <span>@Model.RoleSummary</span>
    </header>

    <partial name="_StatusMessage" for="StatusMessage" />

    <section class="orbi-google-card">
        <div class="orbi-google-card-heading">
            <div><h2>Perfil y correo</h2><p>Administra tus datos básicos y el correo de tu cuenta.</p></div>
            <span class="material-symbols-outlined">person</span>
        </div>

        <form method="post" class="orbi-account-rows">
            <div asp-validation-summary="ModelOnly" class="m3-validation-error" role="alert"></div>
            <div class="orbi-account-row"><label>Nombre de usuario</label><span>@Model.Username</span></div>
            <div class="orbi-account-row"><label>Rol</label><span>@Model.RoleSummary</span></div>
            <div class="m3-text-field">
                <label asp-for="Input.PhoneNumber" class="m3-text-field-label"></label>
                <input asp-for="Input.PhoneNumber" class="m3-text-field-input" autocomplete="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="m3-validation-error"></span>
            </div>
            <button type="submit" class="m3-filled-button">Guardar perfil</button>
        </form>

        <div class="orbi-account-rows">
            <div class="orbi-account-row">
                <span><strong>Correo</strong><br />@Model.Email</span>
                <span class="material-symbols-outlined">@(Model.IsEmailConfirmed ? "verified" : "mark_email_unread")</span>
            </div>
            @if (!Model.IsEmailConfirmed)
            {
                <form method="post" asp-page-handler="SendVerificationEmail">
                    <button type="submit" class="m3-text-button">Enviar correo de verificación</button>
                </form>
            }
            <form method="post" asp-page-handler="ChangeEmail" class="orbi-account-rows">
                <div asp-validation-summary="ModelOnly" class="m3-validation-error" role="alert"></div>
                <div class="m3-text-field">
                    <label asp-for="EmailInput.NewEmail" class="m3-text-field-label">Nuevo correo</label>
                    <input asp-for="EmailInput.NewEmail" class="m3-text-field-input" autocomplete="email" />
                    <span asp-validation-for="EmailInput.NewEmail" class="m3-validation-error"></span>
                </div>
                <button type="submit" class="m3-filled-button">Cambiar correo</button>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
