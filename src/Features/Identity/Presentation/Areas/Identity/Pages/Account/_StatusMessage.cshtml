@model string

@if (!String.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "orbi-alert-error" : "orbi-alert-success";
    <div class="orbi-alert @statusMessageClass" role="alert">
        <button type="button" class="m3-icon-btn orbi-alert-dismiss" data-orbi-dismiss-alert aria-label="Cerrar mensaje">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        @Model
    </div>
}
