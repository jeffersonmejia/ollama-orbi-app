@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Configurar clave";
    ViewData["ActivePage"] = ManageNavPages.Security;
}

<h3>Configurar clave</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    Tu cuenta todavía no tiene una clave. Configúrala para poder iniciar sesión también con tu correo.
</p>
<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="m3-text-field">
                <input asp-for="Input.NewPassword" class="m3-text-field-input" autocomplete="new-password" placeholder="Escribe la nueva clave."/>
                <label asp-for="Input.NewPassword" class="m3-text-field-label">Nueva clave</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="m3-text-field">
                <input asp-for="Input.ConfirmPassword" class="m3-text-field-input" autocomplete="new-password" placeholder="Confirma la nueva clave."/>
                <label asp-for="Input.ConfirmPassword" class="m3-text-field-label">Confirmar clave</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="m3-filled-button">Guardar clave</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
