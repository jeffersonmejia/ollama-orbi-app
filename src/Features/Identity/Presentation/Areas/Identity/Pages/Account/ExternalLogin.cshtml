@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Registro";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Asocia tu cuenta de @Model.ProviderDisplayName.</h2>
<hr />

<p id="external-login-description" class="m3-supporting-text">
    Has iniciado sesión correctamente con <strong>@Model.ProviderDisplayName</strong>.
    Confirma el correo electrónico que usarás en Dash y selecciona «Completar registro» para continuar.
</p>

<div class="m3-form-container">
    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="m3-validation-error" role="alert"></div>
        <div class="m3-text-field">
            <input asp-for="Input.Email" class="m3-text-field-input" autocomplete="email" placeholder="Correo electrónico"/>
            <label asp-for="Input.Email" class="m3-text-field-label">Correo electrónico</label>
            <span asp-validation-for="Input.Email" class="m3-validation-error"></span>
        </div>
        <button type="submit" class="m3-filled-button">Completar registro</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
