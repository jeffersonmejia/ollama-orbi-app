@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div style="max-width:400px;margin:2rem auto;">
    <div class="m3-card" style="padding:2rem;">
        <h1 style="font-size:var(--md-sys-typescale-headline-small-size);font-weight:var(--md-sys-typescale-headline-small-weight);color:var(--md-sys-color-on-surface);margin:0 0 8px;text-align:center;">@ViewData["Title"]</h1>
        <p style="text-align:center;color:var(--md-sys-color-on-surface-variant);font-size:var(--md-sys-typescale-body-medium-size);margin:0 0 1.5rem;">Ingresa el correo electrónico asociado a tu cuenta.</p>

        <form method="post" style="display:grid;gap:1rem;">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="m3-text-field">
                <label class="m3-text-field-label" asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email" class="m3-text-field-input" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="m3-filled-button" style="width:100%;">Restablecer contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
