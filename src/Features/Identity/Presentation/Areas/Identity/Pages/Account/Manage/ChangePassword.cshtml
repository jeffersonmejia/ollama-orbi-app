@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="orbi-account-page">
    <section class="orbi-google-card">
        <div class="orbi-google-card-heading">
            <div><h2>Cambiar contraseña</h2><p>Actualiza la contraseña de acceso a tu cuenta.</p></div>
            <span class="material-symbols-outlined">password</span>
        </div>
        <partial name="_StatusMessage" for="StatusMessage" />
        <form id="change-password-form" method="post" class="orbi-account-rows">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="orbi-account-row orbi-account-row-editable">
                <label asp-for="Input.OldPassword"></label>
                <input asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" placeholder="Ingresa tu contraseña actual" />
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            <div class="orbi-account-row orbi-account-row-editable">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="Ingresa tu nueva contraseña" />
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            <div class="orbi-account-row orbi-account-row-editable">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirma tu nueva contraseña" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            <div><button type="submit" class="m3-filled-button">Actualizar contraseña</button></div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
