@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div style="max-width:400px;margin:2rem auto;">
    <div class="m3-card" style="padding:2rem;">
        <h1 style="font-size:var(--md-sys-typescale-headline-small-size);font-weight:var(--md-sys-typescale-headline-small-weight);color:var(--md-sys-color-on-surface);margin:0 0 1.5rem;text-align:center;">@ViewData["Title"]</h1>

        <form method="post" style="display:grid;gap:1rem;">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="m3-text-field">
                <label class="m3-text-field-label" asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="m3-text-field-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="m3-text-field">
                <label class="m3-text-field-label" asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="m3-text-field-input" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="m3-text-field">
                <label class="m3-text-field-label" asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="m3-text-field-input" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="m3-filled-button" style="width:100%;">Reset</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
