@{
    Layout = ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null
        ? parentLayout.ToString()
        : "/Areas/Identity/Pages/_Layout.cshtml";
}

<div class="orbi-account-shell">
    <header class="orbi-account-shell-header">
        <h1>Cuenta</h1>
        <p>Administra tu información y seguridad.</p>
    </header>
    <div class="orbi-account-layout">
        <aside><partial name="_ManageNav" /></aside>
        <main>@RenderBody()</main>
    </div>
</div>

@section Scripts { @RenderSection("Scripts", required: false) }
