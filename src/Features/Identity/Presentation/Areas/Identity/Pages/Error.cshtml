@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="orbi-route-error" role="alert">
    <span class="material-symbols-outlined" aria-hidden="true">error</span>
    <h1>No pudimos completar tu solicitud</h1>
    <p>Inténtalo de nuevo más tarde.</p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="m3-filled-button">Volver al inicio</a>
</section>
