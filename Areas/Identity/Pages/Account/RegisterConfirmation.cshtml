@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<div style="max-width:400px;margin:2rem auto">
    <div class="m3-card" style="text-align:center">
        <h1 class="m3-headline">@ViewData["Title"]</h1>
        <p style="color:var(--color-text-muted);margin:0">
            Please check your email to confirm your account.
        </p>
        <p style="color:var(--color-text-muted);font-size:0.85rem;margin:0">
            If you don't see the email, check your spam folder.
        </p>
        <a class="m3-filled-button" style="display:inline-block;text-decoration:none;margin-top:0.5rem" asp-page="./Login">
            Return to Login
        </a>
    </div>
</div>

