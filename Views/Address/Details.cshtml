@model SakilaApp.Models.Address

@{
    ViewData["Title"] = "Details";
}

<div class="m3-card" style="max-width:600px;margin:0 auto;padding:24px;">
    <h1 class="m3-headline">Details</h1>
    <div style="display:grid;gap:12px;">
        <div>
            <strong>@Html.DisplayNameFor(model => model.Address1)</strong>
            <div>@Html.DisplayFor(model => model.Address1)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.Address2)</strong>
            <div>@Html.DisplayFor(model => model.Address2)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.District)</strong>
            <div>@Html.DisplayFor(model => model.District)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.PostalCode)</strong>
            <div>@Html.DisplayFor(model => model.PostalCode)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.Phone)</strong>
            <div>@Html.DisplayFor(model => model.Phone)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.LastUpdate)</strong>
            <div>@Html.DisplayFor(model => model.LastUpdate)</div>
        </div>
        <div>
            <strong>@Html.DisplayNameFor(model => model.City)</strong>
            <div>@Html.DisplayFor(model => model.City.CityId)</div>
        </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:16px;">
        <a asp-action="Edit" asp-route-id="@Model?.AddressId" class="m3-filled-button">Edit</a>
        <a asp-action="Index" class="m3-outlined-button">Back to List</a>
    </div>
</div>
